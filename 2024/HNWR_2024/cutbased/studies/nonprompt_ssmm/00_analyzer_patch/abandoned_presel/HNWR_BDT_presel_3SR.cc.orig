     .Field(p + "_originalPt", b.originalPt)
     .Field(p + "_sdMass", b.sdMass)
     .Field(p + "_lsf3", b.lsf3)
     .Field(p + "_area", b.area)
     .Field(p + "_nConstituents", b.nConstituents)
     .Field(p + "_nBHadrons", b.nBHadrons)
     .Field(p + "_nCHadrons", b.nCHadrons)
     .Field(p + "_pnetWithMassTvsQCD", b.pnetWithMassTvsQCD)
     .Field(p + "_pnetWithMassWvsQCD", b.pnetWithMassWvsQCD)
     .Field(p + "_pnetWithMassHbbvsQCD", b.pnetWithMassHbbvsQCD)
