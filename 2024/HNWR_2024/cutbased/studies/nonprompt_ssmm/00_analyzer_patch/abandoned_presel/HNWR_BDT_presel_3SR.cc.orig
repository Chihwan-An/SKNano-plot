}

void HNWR_BDT_presel_3SR::BindPair(RNTupleHandle &h, const std::string &p, PairBranches &b) {
    h.Field("m_" + p, b.m)
     .Field("pt_" + p, b.pt)
     .Field("eta_" + p, b.eta)
     .Field("phi_" + p, b.phi)
     .Field("dR_" + p, b.dR)
     .Field("dPhi_" + p, b.dPhi)
     .Field("chargeProduct_" + p, b.chargeProduct)
     .Field("m_" + p + "jj", b.mjj)
     .Field("pt_" + p + "jj", b.ptjj)
     .Field("dPhi_met_" + p, b.dPhi_met)
     .Field("met_mt_" + p, b.met_mt);
}

