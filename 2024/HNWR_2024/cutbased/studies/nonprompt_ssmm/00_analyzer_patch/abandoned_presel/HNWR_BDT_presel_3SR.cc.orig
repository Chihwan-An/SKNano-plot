HNWR_BDT_presel_3SR::~HNWR_BDT_presel_3SR() {}

// ===========================================================================
//  Corrections / systematics block, copied VERBATIM from HNWR.cc (the v15 port
//  of Reproduce20_002_copy) so both analyzers apply the identical correction
//  set. Keep in sync.
// ===========================================================================
namespace {
// Paths are overridable so a re-derived correction can be tested without a
// rebuild. Defaults point at the staging area the derivation writes to.
const char *kDefaultZptFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt/dy_zpt_nlo_lo.root";
// 2026-08-27: presel-specific R file. resolved_* is a copy of the official
// (cutbased) curves -- the resolved DY CRs of the two analyzers are the same
// selection and the curves agree to <2% -- but boosted_* is derived from THIS
// analyzer's CR_DY_*_boosted (forclaude/test/derive_r_presel.py): the cutbased
// boosted DY CR is defined differently (N candidate from loose lepton + fatjet,
// uncorrected data/MC 0.94 vs 1.08 here), so its boosted R does not transfer.
const char *kDefaultRFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/jetpt/dy_jetpt_ratio_presel3SR.root";
// NLO EW correction EW(genZpT), arXiv:1705.04664, copied verbatim from
// SKFlatAnalyzer data/Run2Legacy_v4/2018/HNWRDYPtReweight/ZPtEWCorr.root.
const char *kDefaultEWFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt_ew/ZPtEWCorr.root";
// GenPart status-62 Z, else status-1 OSSF e/mu pair (HNWRDY::FindGenZ),
// LHE_HT > 40 -- the variant C is delivered in since the 2024 derivation.
const char *kZptVariant = "Zpt_genZ_HT40";

// Read a TH1 into (edges, values, errors).
bool ReadTH1(TFile *f, const TString &path, std::vector<double> &edges,
             std::vector<double> &vals, std::vector<double> *errs = nullptr) {
    TH1 *h = dynamic_cast<TH1 *>(f->Get(path));
    if (!h) return false;
    const int n = h->GetNbinsX();
    edges.resize(n + 1);
    vals.resize(n);
    if (errs) errs->resize(n);
    for (int i = 1; i <= n; i++) {
        edges[i - 1] = h->GetBinLowEdge(i);
        vals[i - 1] = h->GetBinContent(i);
        if (errs) (*errs)[i - 1] = h->GetBinError(i);
    }
    edges[n] = h->GetBinLowEdge(n) + h->GetBinWidth(n);
    return true;
}

int FindBin(const std::vector<double> &edges, double x) {
    if (edges.size() < 2) return -1;
    if (x >= edges.back()) return static_cast<int>(edges.size()) - 2;  // clamp
    if (x < edges.front()) return 0;
    int i = 0;
    while (i + 2 < static_cast<int>(edges.size()) && x >= edges[i + 1]) i++;
    return i;
}

float TransverseMass(float pt1, float pt2, float dphi) {
    const double mt2 = 2.0 * pt1 * pt2 * (1.0 - std::cos(dphi));
    return static_cast<float>(std::sqrt(std::max(0.0, mt2)));
}
}  // namespace

// Inclusive normalisation K of each LHE weight index, which makes the theory
// nuisances acceptance-only. Missing file or missing entry is NOT an error: the
// table only covers signal, and everything else keeps K = 1.
void HNWR_BDT_presel_3SR::LoadTheoryNormK() {
    theoryK_scale.clear();
    theoryK_pdf.clear();
    if (IsDATA) return;

    const std::string path = Nano15Analyzers::OptionalModuleFile(
        "HNWR/data/TheoryNormK/" + std::string(DataEra.Data()) + "/TheoryNormK.json");
    if (path.empty()) {
        std::cout << "[HNWR_BDT_presel_3SR] no theory-K table for " << DataEra
                  << " in the module data; theory nuisances stay un-normalised." << std::endl;
        return;
    }
    std::ifstream f(path);
    if (!f.is_open()) {
        std::cout << "[HNWR_BDT_presel_3SR] no theory-K table at " << path
                  << "; theory nuisances stay un-normalised." << std::endl;
        return;
    }

    nlohmann::json j;
    try {
        f >> j;
    } catch (const std::exception &e) {
        // v13 printed to cerr and called exit(EXIT_FAILURE); the v15 job driver
        // collects a throw into its FailureContext instead.
        throw SKNano::ConfigError("[HNWR_BDT_presel_3SR] cannot parse " + path + ": " + e.what());
    }

    const std::string key = std::string(MCSample.Data());
    if (!j.contains("samples") || !j["samples"].contains(key)) {
        std::cout << "[HNWR_BDT_presel_3SR] " << MCSample << " not in " << path
                  << " (background, or a signal alias without the full 103 PDF members); "
                  << "theory nuisances stay un-normalised." << std::endl;
        return;
    }

    const auto &s = j["samples"][key];
    if (s.contains("scale")) theoryK_scale = s["scale"].get<std::vector<float>>();
    if (s.contains("pdf"))   theoryK_pdf   = s["pdf"].get<std::vector<float>>();

    // A short table would silently fall back to K = 1 for the missing entries and
    // mix normalised with un-normalised members, so refuse it outright.
    if (theoryK_scale.size() != 9 || theoryK_pdf.size() != 103) {
        throw SKNano::ConfigError(
            "[HNWR_BDT_presel_3SR] " + key + " in " + path + " has scale[" +
            std::to_string(theoryK_scale.size()) + "] pdf[" +
            std::to_string(theoryK_pdf.size()) + "], expected scale[9] pdf[103].");
    }

    std::cout << "[HNWR_BDT_presel_3SR] theory-K loaded for " << MCSample << " (" << DataEra
              << "): muF idx3/idx5 = " << theoryK_scale[3] << "/" << theoryK_scale[5]
              << ", alphaS idx101/102 = " << theoryK_pdf[101] << "/" << theoryK_pdf[102]
              << ". Theory nuisances are acceptance-only." << std::endl;
}

std::string HNWR_BDT_presel_3SR::PDFMemberKey(int i) {
    return std::string(TString::Format("PDFmem%03d", i).Data());
}

float HNWR_BDT_presel_3SR::GetTheoryNormK(const std::vector<float> &K, int idx) const {
    if (idx < 0 || idx >= static_cast<int>(K.size())) return 1.f;
    const float k = K[idx];
    return (std::isfinite(k) && k > 0.f) ? k : 1.f;
}

// Copied verbatim from v13 Analyzers/src/AnalyzerCore.cc; v15's AnalyzerCore
// kept GetScaleVariation but dropped this index helper.
//
// The index this returns is the one the K table (data/TheoryNormK/<era>/
// TheoryNormK.json, scale[9]) is laid out in, and since commit 6df8e69f
// AnalyzerCore::GetScaleVariation derives its slot the same way (3*iR + iF,
// nominal dropped only for 8-entry samples), so weight and normalisation refer
// to the same LHEScaleWeight member. Keep the two in step if either changes.
int HNWR_BDT_presel_3SR::GetScaleVariationIndex(const MyCorrection::variation &muF_syst,
                                                const MyCorrection::variation &muR_syst) const {
    if (!nLHEScaleWeight.valid() || nLHEScaleWeight == 0) return -1;

    // (muF, muR) == (nom, nom) is the central value by definition: no index to read.
    if (muF_syst == MyCorrection::variation::nom && muR_syst == MyCorrection::variation::nom)
        return -1;

    // Standard NanoAOD LHEScaleWeight ordering: muR is the outer (slow) index,
    // muF the inner (fast) index, i.e. index = 3*iR + iF with i in {down,nom,up}.
    //   9-element samples INCLUDE the nominal (muR=1,muF=1) at index 4.
    //   8-element samples OMIT the nominal, so every entry from the nominal slot
    //     onward is shifted down by one.
    auto varIndex = [](const MyCorrection::variation &v) -> int {
        if (v == MyCorrection::variation::down) return 0;
        if (v == MyCorrection::variation::up)   return 2;
        return 1;  // nom
    };
    const int idx = 3 * varIndex(muR_syst) + varIndex(muF_syst);

    if (nLHEScaleWeight == 9) return idx;                     // direct 3x3 grid
    if (nLHEScaleWeight == 8) return idx > 4 ? idx - 1 : idx; // nominal slot removed
    return -1;                                                // unexpected multiplicity
}

// === TEMPORARY: theory / DY systematics disabled ==============================
// Set to false to restore. While true:
//   - initializeAnalyzer() loads data/config/MCLRSM_noTheoryDY.yaml instead of
//     MCLRSM.yaml, so the ScaleWeight_muF / ScaleWeight_muR / AlphaS and the
//     seven ZPtRw* nuisances are not scheduled at all.
//   - LoadDYCorrections() returns early, exactly as the NoDYCorr userflag does,
//     so C(genZpT), EW(genZpT) and R(jet pT) are all 1 and the per-bin
//     DYReshape nuisances iterate zero times.
// The two have to move together: ZPtRw_MC_stat / ZPtRwEW1 are the yaml entries
// that carry C and EW at nominal into the central weight, so dropping them from
// the yaml already removes the correction -- the early return just makes that
// explicit instead of implicit, and also switches R off.
static constexpr bool kTempNoTheoryDYSyst = false;
// =============================================================================

bool HNWR_BDT_presel_3SR::IsDYSample() const {
    // The LO HT-binned madgraphMLM DY set the analysis uses as its DY
    // background and that C corrects towards NLO: v13 aliases DYMLL<m>HT<h>,
    // v15/2024 aliases DYto2L_MLL<m>_HT<h>. The NLO mass-binned DYto2E/DYto2Mu
    // samples are the numerator of C and must not match here.
    if (IsDATA) return false;
    if (MCSample.Contains("DYMLL")) return true;
    return MCSample.Contains("DYto2L_MLL") && MCSample.Contains("_HT");
}

void HNWR_BDT_presel_3SR::LoadDYCorrections() {
    dycorr = DYCorrections();
    if (!IsDYSample()) return;
    // TEMPORARY: see kTempNoTheoryDYSyst above.
    if (kTempNoTheoryDYSyst) {
        std::cout << "[HNWR_BDT_presel_3SR] DY corrections OFF for " << MCSample << " / " << DataEra
                  << " (C=off EW=off R=off): this build runs without the theory and DY "
                     "systematics (kTempNoTheoryDYSyst)." << std::endl;
        return;
    }
    if (NoDYCorr || std::getenv("DY_NO_CORRECTION")) {
        std::cout << "[HNWR_BDT_presel_3SR] DY corrections OFF for " << MCSample
                  << " / " << DataEra << " (C=off R=off), requested by "
                  << (NoDYCorr ? "userflag NoDYCorr" : "DY_NO_CORRECTION") << "." << std::endl;
        return;
    }

    // --- C. Era-specific; there is no combined fallback, reweighting one era
    // with another's curve would be silently wrong.
    const char *zenv = std::getenv("DY_ZPT_CORRECTION");
    const TString zpath = zenv ? zenv : kDefaultZptFile;
    std::unique_ptr<TFile> zf(TFile::Open(zpath));
    if (!zf || zf->IsZombie())
        throw SKNano::ConfigError("[HNWR_BDT_presel_3SR] cannot open " + std::string(zpath.Data()));
    const TString zdir = TString(kZptVariant) + "/" + DataEra + "/";
    for (const char *key : {"ZPTReweight", "ZPTReweight_Up", "ZPTReweight_Down",
                            "ZPTReweight_QCDScaleUp", "ZPTReweight_QCDScaleDown",
                            "ZPTReweight_QCDPDFErrorUp", "ZPTReweight_QCDPDFErrorDown",
                            "ZPTReweight_QCDPDFAlphaSUp", "ZPTReweight_QCDPDFAlphaSDown"}) {
        std::vector<double> e, v, s;
        if (!ReadTH1(zf.get(), zdir + key, e, v, &s)) {
            throw SKNano::ConfigError(
                "[HNWR_BDT_presel_3SR] " + std::string((zdir + key).Data()) + " missing in " +
                std::string(zpath.Data()) + ". C is delivered per era; for a missing era run "
                "Nano15_Analyzers/HNWR/scripts/run_dy_corrections.sh (steps 1-2).");
        }
        if (dycorr.zpt_edges.empty()) dycorr.zpt_edges = e;
        dycorr.zpt[key] = v;
        // The MC statistical error of C is carried by the bin errors of the
        // nominal histogram alone; every other key is written with zero errors.
        if (std::string(key) == "ZPTReweight") dycorr.zpt_stat = s;
    }

    // --- R. Rebinned curves only. ZptOnly skips R entirely rather than loading
    // it and multiplying by 1, so n_nuis_res/boo stay 0 with it.
    const char *renv = std::getenv("DY_JETPT_CORRECTION");
    const TString rpath = ZptOnly ? "(not loaded)" : (renv ? renv : kDefaultRFile);
    if (!ZptOnly) {
        std::unique_ptr<TFile> rf(TFile::Open(rpath));
        if (!rf || rf->IsZombie())
            throw SKNano::ConfigError("[HNWR_BDT_presel_3SR] cannot open " +
                                      std::string(rpath.Data()));
        for (int cat = 0; cat < 2; cat++) {
            const TString rdir =
                TString(cat == 0 ? "resolved_comb/" : "boosted_comb/") + DataEra + "/";
            std::vector<double> &edges = cat == 0 ? dycorr.r_edges_res : dycorr.r_edges_boo;
            std::vector<double> &vals = cat == 0 ? dycorr.r_val_res : dycorr.r_val_boo;
            std::vector<double> &sigs = cat == 0 ? dycorr.r_sig_res : dycorr.r_sig_boo;
            if (!ReadTH1(rf.get(), rdir + "rebinned/R_nominal", edges, vals, &sigs)) {
                throw SKNano::ConfigError(
                    "[HNWR_BDT_presel_3SR] " + std::string(rdir.Data()) +
                    "rebinned/R_nominal missing in " + std::string(rpath.Data()));
            }
            int n = 0;
            for (double v : vals) if (std::isfinite(v) && v > 0.) n++;
            (cat == 0 ? dycorr.n_nuis_res : dycorr.n_nuis_boo) = n;
        }
    }

    // --- EW. Applied alongside C exactly as in SKFlat HNWRAnalyzer: whenever the
    // Z-pT correction is on, EW is on (ZptOnly turns off R, not EW).
    const char *ewenv = std::getenv("DY_ZPT_EW_CORRECTION");
    const TString ewpath = ewenv ? ewenv : kDefaultEWFile;
    std::unique_ptr<TFile> ewf(TFile::Open(ewpath));
    if (!ewf || ewf->IsZombie())
        throw SKNano::ConfigError("[HNWR_BDT_presel_3SR] cannot open " +
                                  std::string(ewpath.Data()));
    {
        std::vector<double> dummy_e, dummy_v;
        if (!ReadTH1(ewf.get(), "hist_v", dycorr.ew_edges, dycorr.ew_val) ||
            !ReadTH1(ewf.get(), "hist_e1", dummy_e, dummy_v, &dycorr.ew_e1) ||
            !ReadTH1(ewf.get(), "hist_e2", dummy_e, dummy_v, &dycorr.ew_e2) ||
            !ReadTH1(ewf.get(), "hist_e3", dummy_e, dummy_v, &dycorr.ew_e3)) {
            throw SKNano::ConfigError("[HNWR_BDT_presel_3SR] hist_v/e1/e2/e3 missing in " +
                                      std::string(ewpath.Data()));
        }
    }

    dycorr.loaded = true;
    dycorr.apply = true;
    dycorr.apply_r = !ZptOnly;
    dycorr.apply_ew = true;
    std::cout << "[HNWR_BDT_presel_3SR] DY corrections on for " << MCSample << " / "
              << DataEra << ": C=on R=" << (dycorr.apply_r ? "on" : "off (userflag ZptOnly)")
              << " EW=on, C from " << zpath << " (" << dycorr.zpt_edges.size() - 1
              << " bins), R from " << rpath << " (" << dycorr.n_nuis_res
              << " resolved + " << dycorr.n_nuis_boo << " boosted nuisance bins)"
              << ", EW from " << ewpath << " (" << dycorr.ew_edges.size() - 1
              << " bins)" << std::endl;
}

float HNWR_BDT_presel_3SR::GetGenZpT() const {
    // One definition for derivation and application: HNWRDY::FindGenZ
    // (GenPart status-62 Z, else the leading status-1 OSSF e/mu pair).
    // -1 when neither exists; every DY target then returns 1.
    return HNWRDY::FindGenZ(gens).pt;
}

float HNWR_BDT_presel_3SR::GetZptWeight(float gen_zpt, const std::string &key) const {
    if (!dycorr.apply || gen_zpt < 0.) return 1.f;
    auto it = dycorr.zpt.find(key);
    if (it == dycorr.zpt.end() || it->second.empty()) return 1.f;
    const int i = FindBin(dycorr.zpt_edges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(it->second.size())) return 1.f;
    const double c = it->second[i];
    if (!std::isfinite(c) || c <= 0.) return 1.f;
    return static_cast<float>(c);
}

float HNWR_BDT_presel_3SR::GetZptStat(float gen_zpt) const {
    if (!dycorr.apply || gen_zpt < 0.) return 0.f;
    if (dycorr.zpt_stat.empty()) return 0.f;
    const int i = FindBin(dycorr.zpt_edges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(dycorr.zpt_stat.size())) return 0.f;
    const double s = dycorr.zpt_stat[i];
    // NaN where C is NaN (empty LO denominator). GetZptWeight falls back to 1
    // there, so the variation has to be 0 to stay on top of that fallback.
    if (!std::isfinite(s) || s < 0.) return 0.f;
    return static_cast<float>(s);
}

float HNWR_BDT_presel_3SR::GetZptEW(float gen_zpt, int which, int dir) const {
    if (!dycorr.apply || !dycorr.apply_ew || gen_zpt < 0.) return 1.f;
    if (dycorr.ew_val.empty()) return 1.f;
    // FindBin clamps both sides, reproducing the SKFlat clipping.
    const int i = FindBin(dycorr.ew_edges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(dycorr.ew_val.size())) return 1.f;
    double v = dycorr.ew_val[i];
    if (!std::isfinite(v) || v <= 0.) return 1.f;
    if (which >= 1 && which <= 3 && dir != 0) {
        const std::vector<double> &errs =
            which == 1 ? dycorr.ew_e1 : which == 2 ? dycorr.ew_e2 : dycorr.ew_e3;
        if (i < static_cast<int>(errs.size()) && std::isfinite(errs[i]))
            v += dir * errs[i];
        // Never hand back <= 0: that would delete the event instead of down-weighting it.
        if (v <= 0.) v = 1e-3;
    }
    return static_cast<float>(v);
}

float HNWR_BDT_presel_3SR::GetJetPtR(bool resolved, float pt, int nuis_bin, int dir) const {
    if (!dycorr.apply || !dycorr.apply_r || pt < 0.) return 1.f;
    const std::vector<double> &edges = resolved ? dycorr.r_edges_res : dycorr.r_edges_boo;
    const std::vector<double> &vals = resolved ? dycorr.r_val_res : dycorr.r_val_boo;
    const std::vector<double> &sigs = resolved ? dycorr.r_sig_res : dycorr.r_sig_boo;
    if (vals.empty()) return 1.f;
    const int i = FindBin(edges, pt);
    if (i < 0 || i >= static_cast<int>(vals.size())) return 1.f;

    double r = vals[i];
    // Undefined bins are NaN in the file. 1.0 means "no correction"; 0 would
    // delete the DY prediction instead.
    if (!std::isfinite(r) || r <= 0.) return 1.f;

    if (nuis_bin >= 0 && nuis_bin == i && dir != 0) {
        const double s = (i < static_cast<int>(sigs.size()) && std::isfinite(sigs[i]))
                             ? sigs[i] : 0.;
        r += (dir > 0 ? s : -s);
        if (!std::isfinite(r) || r <= 0.) return 1.f;
    }
    return static_cast<float>(r);
}

// eta MUST be the supercluster eta (ElectronView::ScEta()), not the track eta: the
// barrel/endcap split is at the SC crack edge |eta| = 1.4442.
float HNWR_BDT_presel_3SR::GetElectronTriggerSF_TnP(double eta, double pt,
                                                    MyCorrection::variation var) const {
    // 2024 is binned in (signed SC eta, pT); the earlier eras only ever had a
    // barrel/endcap constant from the pT > 130 fit.
    if (DataEra == "2024") {
        const int syst = (var == MyCorrection::variation::up)     ?  1
                       : (var == MyCorrection::variation::down)  ? -1 : 0;
        return HNWRTrigSF::Get2024(eta, pt, syst);
    }

    const bool isBarrel = std::fabs(eta) < 1.4442;

    float sf, err;
    if      (DataEra == "2022")     { sf = isBarrel ? 0.995f : 0.991f; err = isBarrel ? 0.004f : 0.009f; }
    else if (DataEra == "2022EE")   { sf = isBarrel ? 0.990f : 0.981f; err = isBarrel ? 0.007f : 0.017f; }
    else if (DataEra == "2023")     { sf = isBarrel ? 0.992f : 0.979f; err = isBarrel ? 0.006f : 0.019f; }
    else if (DataEra == "2023BPix") { sf = isBarrel ? 0.993f : 0.978f; err = isBarrel ? 0.001f : 0.019f; }
    else return 1.0;  // no measurement for this era (e.g. 2017)

    if (var == MyCorrection::variation::up)   return sf + err;
    if (var == MyCorrection::variation::down) return sf - err;
    return sf;
}

// eta MUST be the supercluster eta (ElectronView::ScEta()): the EGM SF is binned in
// signed SC eta with crack bins at |eta| 1.4442-1.566.
//
// HEEP ID scale factor from the EGM heep-id branch of electron.json.gz
// (era yml entry "electron_heep", MyCorrection::GetElectronHEEPIDSF; pt binned
// from 35 GeV, clamped there). Eras without that file keep the v13-era
// behaviour of returning 1.0 and say so once, so the ElectronID nuisance is a
// no-op only where the input is genuinely missing.
float HNWR_BDT_presel_3SR::GetElectronHEEPIDSF_TnP(double eta, double pt, MyCorrection::variation var) const {
    if (myCorr && myCorr->HasElectronHEEPIDSF())
        return myCorr->GetElectronHEEPIDSF(static_cast<float>(eta), static_cast<float>(pt), var);
    // Function-local rather than a member flag: the header has no mutable slot for it.
    static bool warned = false;
    if (!warned) {
        std::cerr << "[HNWR_BDT_presel_3SR::GetElectronHEEPIDSF_TnP] WARNING: no HEEP electron ID scale "
                  << "factor configured for era " << DataEra
                  << " (era yml has no electron_heep entry). Returning 1.0; "
                  << "the ElectronID nuisance is a no-op." << std::endl;
        warned = true;
    }
    return 1.0;
}

// LSF3 cut efficiency scale factor, keyed by the flavor of the lepton inside the fatjet:
//   muon-in-fatjet     (measured in the e-mujet flavor CR): 1.06 +- 0.10
//   electron-in-fatjet (measured in the mu-ejet flavor CR): 1.11 +- 0.11
float HNWR_BDT_presel_3SR::GetLSFSF(bool muonInFatJet, MyCorrection::variation var) const {
    const float sf  = muonInFatJet ? 1.06f : 1.11f;
    const float err = muonInFatJet ? 0.10f : 0.11f;
    if (var == MyCorrection::variation::up)   return sf + err;
    if (var == MyCorrection::variation::down) return sf - err;
    return sf;
}

//================ Electron ID helpers ================//

// PORT CAVEAT: v13 read deltaEtaInSeed() and deltaPhiInSC() here. Both are
// hard-coded -999 stubs in v15's ElectronView (the NanoAODv15 branches behind
// them were never wired up), so the two |x| < cut tests below can never pass.
// The body is kept byte-for-byte so restoring the accessors restores the ID; it
// is dead code today -- nothing in the 3SR selection path calls it (v13 did not
// call it either, the tier definitions use PassID / isPassLooseNoIso).
bool HNWR_BDT_presel_3SR::isPassCustomLooseID(const ElectronView &el) const {
    const float E = static_cast<float>(el.P4().E());
    if (std::fabs(el.ScEta()) <= 1.479) {
        if (!(el.hoe() < 0.05 + 1.28 / E + 0.0422 * el.Rho() / E)) return false;
        if (!(el.sieie() < 0.00107)) return false;
        if (!(std::fabs(el.deltaEtaInSeed()) < 0.00691)) return false;
        if (!(std::fabs(el.deltaPhiInSC()) < 0.175)) return false;
        if (!(std::fabs(el.eInvMinusPInv()) < 0.138)) return false;
        if (!(el.LostHits() <= 1)) return false;
        if (!(el.ConvVeto())) return false;
        return true;
    } else {
        if (!(el.hoe() < 0.05 + 2.3 / E + 0.262 * el.Rho() / E)) return false;
        if (!(el.sieie() < 0.0275)) return false;
        if (!(std::fabs(el.deltaEtaInSeed()) < 0.0121)) return false;
        if (!(std::fabs(el.deltaPhiInSC()) < 0.228)) return false;
        if (!(std::fabs(el.eInvMinusPInv()) < 0.127)) return false;
        if (!(el.LostHits() <= 1)) return false;
        if (!(el.ConvVeto())) return false;
        return true;
    }
}

// Endcap-relaxed HEEP: the standard HEEP bits minus H/E and EM+HadDepth1, both
// recomputed with the rho-dependent cut. Not used by the 3SR selection (kept so
// the analyzer stays a drop-in copy of Reproduce20_002_copy's helper set).
bool HNWR_BDT_presel_3SR::isPassCustomTightID(const ElectronView &el) const {
    if (std::fabs(el.ScEta()) < 1.566) {
        return el.PassID(el_set.Electron_Tight_ID[0]);
    }
    const int heepbit = Electron_vidNestedWPBitmapHEEP[el.rawIndex()];
    if (!((heepbit & 3775) == 3775)) return false;
    const float scEtOverPt = Electron_scEtOverPt[el.rawIndex()];
    const float scE = (scEtOverPt + 1) * el.Pt();
    const double cutValue_HoverE = (-0.4 + 0.4 * std::fabs(el.ScEta())) * el.Rho() / scE + 0.05;
    if (!(el.hoe() < cutValue_HoverE)) return false;
    const double cutValue_emhaddep1 =
        el.Pt() > 50. ? 2.5 + 0.03 * (el.Pt() - 50.) +
                            (0.15 + 0.07 * std::fabs(el.ScEta())) * el.Rho()
                      : 2.5 + (0.15 + 0.07 * std::fabs(el.ScEta())) * el.Rho();
    if (!(el.dr03EcalRecHitSumEt() + el.dr03HcalDepth1TowerSumEt() < cutValue_emhaddep1))
        return false;
    return true;
}

// Loose ID without isolation (the Python vidNestedWPBitmap decoding with
// id_level = 2, ignoring the isolation cut). v13 read the bitmap through
// Electron::VidNestedWPBitmap(); ElectronView has no such accessor, so the raw
// branch is indexed with the electron's raw index. The decoding is unchanged.
// HEEP-loose for the fake-rate method (FakeRate mode). Keeps the HEEP bits that
// define "an electron-like track+cluster" (Et, SC eta range, dEtaSeed, dPhiIn,
// dxy, missing hits, ecal-driven) and relaxes the four cuts where the endcap
// data excess sits (2026-08-27 nolep CR study: hadronic fakes fail sieie / H/E /
// track iso, photon conversions pass everything): sieie, E2x5/E5x5 (EB), H/E,
// track iso, EM+Had depth1 iso. HEEP itself passes all of these by construction.
// Bit order of Electron_vidNestedWPBitmapHEEP (HEEP v7): 0 MinPt, 1 SCEta,
// 2 DEtaSeed, 3 DPhiIn, 4 sieie, 5 E2x5/E5x5, 6 H/E, 7 trkIso, 8 EM+HadD1 iso,
// 9 dxy, 10 missing hits, 11 ecal-driven (same map isPassCustomTightID uses).
bool HNWR_BDT_presel_3SR::isPassHEEPLoose(const ElectronView &el) const {
    const int heepbit = Electron_vidNestedWPBitmapHEEP[el.rawIndex()];
    const int keep = (1 << 0) | (1 << 1) | (1 << 2) | (1 << 3) | (1 << 9) | (1 << 10) | (1 << 11);
    if ((heepbit & keep) != keep) return false;
    const bool isEB = std::fabs(el.ScEta()) < 1.479f;
    // V1: wide shape cuts; V2 (userflag LooseV2): HLT CaloIdVT-level shape cuts,
    // only the isolation relaxed (see the header).
    const float sieieCut = HEEPLooseV2 ? (isEB ? kHEEPLooseV2SieieEB : kHEEPLooseV2SieieEE)
                                       : (isEB ? kHEEPLooseSieieEB : kHEEPLooseSieieEE);
    const float hoeCut = HEEPLooseV2 ? (isEB ? kHEEPLooseV2HoEEB : kHEEPLooseV2HoEEE) : kHEEPLooseHoE;
    const float trkCut = HEEPLooseV2 ? kHEEPLooseV2TrkIso : kHEEPLooseTrkIso;
    const float emhadScale = HEEPLooseV2 ? kHEEPLooseV2EmHadScale : kHEEPLooseEmHadScale;
    if (!(el.sieie() < sieieCut)) return false;
    if (!(el.hoe() < hoeCut)) return false;
    if (!(el.dr03TkSumPtHEEP() < trkCut)) return false;
    const float et = el.Pt();
    const float rho = el.Rho();
    const float emhadCut = isEB ? (2.f + 0.03f * et + 0.28f * rho)
                                : (et < 50.f ? 2.5f + 0.28f * rho
                                             : 2.5f + 0.03f * (et - 50.f) + 0.28f * rho);
    if (!(el.dr03EcalRecHitSumEt() + el.dr03HcalDepth1TowerSumEt() < emhadScale * emhadCut))
        return false;
    return true;
}

bool HNWR_BDT_presel_3SR::isPassLooseNoIso(const ElectronView &el) const {
    const int bitmap = Electron_vidNestedWPBitmap[el.rawIndex()];
    const int n_cuts = 10;
    const int bits_per_cut = 3;
    const int ignore_cut = 7;   // isolation cut index (ignored)
    const int id_level = 2;     // Loose working point
    const int mask = (1 << bits_per_cut) - 1;
    for (int cut_nr = 0; cut_nr < n_cuts; cut_nr++) {
        if (cut_nr == ignore_cut) continue;
        const int value = (bitmap >> (cut_nr * bits_per_cut)) & mask;
        if (value < id_level) return false;
    }
    return true;
}

//================ Cleaning helpers ================//

std::vector<HNWR_BDT_presel_3SR::FatJetRec>
HNWR_BDT_presel_3SR::Clean_Fatjet_with_tight_leptons(
    const std::vector<FatJetRec> &fatjets,
    const std::vector<const LepRef *> &tight_leps) const {
    std::vector<FatJetRec> cleaned;
    cleaned.reserve(fatjets.size());
    for (const auto &fatjet : fatjets) {
        bool isDRtoLepton = false;
        for (const auto *lep : tight_leps) {
            if (fatjet.p4.DeltaR(lep->p4) < 0.4) { isDRtoLepton = true; break; }
        }
        if (!isDRtoLepton) cleaned.push_back(fatjet);
    }
    return cleaned;
}

// v13 cleaned the owned RVec<Jet> before SelectJets. Views cannot be filtered
// into a new collection, so the surviving positions are returned instead and fed
// to SelectJetIndices as its seed set. dR uses eta/phi only, which no JES/JER
// lane touches, so the result is independent of the lane the jets are read in.
std::vector<std::size_t> HNWR_BDT_presel_3SR::Clean_jetidx_with_loose_leptons(
    const JetViewCollection &jets,
    const std::vector<const LepRef *> &loose_leps) const {
    std::vector<std::size_t> cleaned;
    cleaned.reserve(jets.size());
    for (std::size_t i = 0; i < jets.size(); i++) {
        const auto jet = jets[i];
        TLorentzVector p4;
        p4.SetPtEtaPhiM(1.f, jet.Eta(), jet.Phi(), 0.f);
        bool isDRtoLepton = false;
        for (const auto *lep : loose_leps) {
            if (p4.DeltaR(lep->p4) < 0.4) { isDRtoLepton = true; break; }
        }
        if (!isDRtoLepton) cleaned.push_back(i);
    }
    return cleaned;
}

// Resolved priority: AK4 jets win, so drop any fatjet overlapping a selected jet.
std::vector<HNWR_BDT_presel_3SR::FatJetRec> HNWR_BDT_presel_3SR::Clean_Fatjet_with_jets(
    const std::vector<FatJetRec> &fatjets,
    const std::vector<SelectedJetView> &jets) const {
    std::vector<FatJetRec> cleaned;
    cleaned.reserve(fatjets.size());
    for (const auto &fatjet : fatjets) {
        bool isDRtoJet = false;
        for (const auto &jet : jets) {
            if (fatjet.p4.DeltaR(jet.P4()) < dR_JetFatJet) { isDRtoJet = true; break; }
        }
        if (!isDRtoJet) cleaned.push_back(fatjet);
    }
    return cleaned;
}

// Boosted priority: fatjets win, so drop any AK4 jet overlapping a selected fatjet.
std::vector<SelectedJetView> HNWR_BDT_presel_3SR::Clean_jet_with_fatjets(
    const std::vector<SelectedJetView> &jets,
    const std::vector<FatJetRec> &fatjets) const {
    std::vector<SelectedJetView> cleaned;
    cleaned.reserve(jets.size());
    for (const auto &jet : jets) {
        const TLorentzVector p4 = jet.P4();
        bool isDRtoFatJet = false;
        for (const auto &fatjet : fatjets) {
            if (p4.DeltaR(fatjet.p4) < dR_JetFatJet) { isDRtoFatJet = true; break; }
        }
        if (!isDRtoFatJet) cleaned.push_back(jet);
    }
    return cleaned;
}

//================ Object-variation lanes ================//
// v13 rebuilt the collections with ScaleMuons/SmearMuons/ScaleElectrons/
// SmearElectrons/SmearJets/ScaleJets/SmearFatJets/ScaleFatJets. v15 views are
// immutable: the variation is a lane picked at read time, and the physics content
// of each lane is the same correction v13 applied.

float HNWR_BDT_presel_3SR::MuonVarPt(const MuonView &mu) const {
    // This analysis selects POG_GLOBAL_HIGH_PT muons, so every lane is the
    // high-pT one -- HighPtPt() is TuneP with the Generalized-Endpoint scale
    // above 200 GeV and the Rochester-corrected pt below, i.e. exactly what
    // v13's GetAllMuons() built. Plain Pt() would be Rochester everywhere and
    // would silently change the high-pT selection.
    switch (fLepVar) {
    case LepVariation::MuScaleUp:   return mu.HighPtScaleUp();
    case LepVariation::MuScaleDown: return mu.HighPtScaleDown();
    case LepVariation::MuResUp:     return mu.HighPtResUp();
    case LepVariation::MuResDown:   return mu.HighPtResDown();
    default:                        return mu.HighPtPt();
    }
}

float HNWR_BDT_presel_3SR::ElectronVarPt(const ElectronView &el) const {
    switch (fLepVar) {
    case LepVariation::EleScaleUp:   return el.ScaleUpPt();
    case LepVariation::EleScaleDown: return el.ScaleDownPt();
    case LepVariation::EleResUp:     return el.SmearUpPt();
    case LepVariation::EleResDown:   return el.SmearDownPt();
    default:                         return el.Pt();
    }
}

float HNWR_BDT_presel_3SR::FatJetVarPt(const FatJetView &fj) const {
    // Must match AnalyzerCore::SelectFatJets exactly, or the pt used downstream
    // would not be the pt the selection cut on.
    if (IsDATA) return fj.CorrectedPt();
    if (fJesVar == MyCorrection::variation::up)   return fj.JesPtUp();
    if (fJesVar == MyCorrection::variation::down) return fj.JesPtDown();
    if (fJerVar == MyCorrection::variation::up)   return fj.SmearedPtUp();
    if (fJerVar == MyCorrection::variation::down) return fj.SmearedPtDown();
    return fj.SmearedPtNominal();
}

float HNWR_BDT_presel_3SR::FatJetVarMass(const FatJetView &fj) const {
    if (IsDATA) return fj.CorrectedMass();
    if (fJesVar == MyCorrection::variation::up)   return fj.JesMassUp();
    if (fJesVar == MyCorrection::variation::down) return fj.JesMassDown();
    if (fJerVar == MyCorrection::variation::up)   return fj.SmearedMassUp();
    if (fJerVar == MyCorrection::variation::down) return fj.SmearedMassDown();
    return fj.SmearedMassNominal();
}

float HNWR_BDT_presel_3SR::FatJetVarSDMass(const FatJetView &fj) const {
    // m_SD is corrected by applying the AK4 JERC to the subjets and recomputing
    // their invariant mass. FatJetView::SDMass() is the raw NanoAOD value and is
    // never right here; SDMassNominal() already carries the nominal subjet
    // smearing, which is what v13 got on every pass. SDMass is a BDT input in
    // this analyzer rather than a cut, but it still has to follow the variation.
    if (IsDATA) return fj.SDMassNominal();
    if (fJesVar == MyCorrection::variation::up)   return fj.SDMassJesUp();
    if (fJesVar == MyCorrection::variation::down) return fj.SDMassJesDown();
    if (fJerVar == MyCorrection::variation::up)   return fj.SDMassJerUp();
    if (fJerVar == MyCorrection::variation::down) return fj.SDMassJerDown();
    return fj.SDMassNominal();
}

// GetTaggerResult throws when a tagger x score column is not bound in the input
// file, and NanoAODv15 does not ship every combination v13 wrote. These branches
// are BDT inputs, never cuts, so an unavailable score becomes -999 instead of
// killing the job. The availability answer is a property of the campaign, so it
// is cached after the first probe rather than re-thrown for every jet.
float HNWR_BDT_presel_3SR::SafeJetTag(const SelectedJetView &jet,
                                      JetTagging::JetFlavTagger tagger,
                                      JetTagging::JetFlavTaggerScoreType score) const {
    static std::map<int, bool> available;
    const int key = static_cast<int>(tagger) * 100 + static_cast<int>(score);
    const auto it = available.find(key);
    if (it != available.end() && !it->second) return fMissing;
    try {
        const float value = static_cast<const JetView &>(jet).GetTaggerResult(tagger, score);
        available[key] = true;
        return value;
    } catch (const std::exception &) {
        available[key] = false;
        return fMissing;
    }
}

float HNWR_BDT_presel_3SR::SafeFatJetTag(const FatJetView &fj,
                                         JetTagging::FatJetTagger tagger,
                                         JetTagging::FatJetTaggerScoreType score) const {
    static std::map<int, bool> available;
    const int key = static_cast<int>(tagger) * 100 + static_cast<int>(score);
    const auto it = available.find(key);
    if (it != available.end() && !it->second) return fMissing;
    try {
        const float value = fj.GetTaggerResult(tagger, score);
        available[key] = true;
        return value;
    } catch (const std::exception &) {
        available[key] = false;
        return fMissing;
    }
}

// ===========================================================================
//  Row state
//  v13's SetBranch scatter API left any branch a code path did not touch at its
//  previous-event value. Reset() + SetMissing() make that impossible: every
//  entry starts from a defined state and an absent object writes the same
//  -999 / false sentinels v13's `obj ? ... : fMissing` ternaries produced.
// ===========================================================================
void HNWR_BDT_presel_3SR::EleBranches::SetMissing() {
    *this = EleBranches();
    pt = fMissing; eta = fMissing; phi = fMissing; mass = fMissing; charge = fMissing;
    isFilled = false;
    dxy = fMissing; dxyErr = fMissing; dz = fMissing; dzErr = fMissing;
    ip3d = fMissing; sip3d = fMissing;
    pfRelIso03 = fMissing; miniPFRelIso = fMissing; scEta = fMissing;
    deltaEtaInSC = fMissing; deltaEtaInSeed = fMissing;
    deltaPhiInSC = fMissing; deltaPhiInSeed = fMissing;
    ecalPFClusterIso = fMissing; hcalPFClusterIso = fMissing;
    dr03EcalRecHitSumEt = fMissing; dr03HcalDepth1TowerSumEt = fMissing;
    dr03TkSumPt = fMissing; dr03TkSumPtHEEP = fMissing;
    hoe = fMissing; sieie = fMissing; eInvMinusPInv = fMissing;
    energyErr = fMissing; r9 = fMissing; rho = fMissing; scEtOverPt = fMissing;
    convVeto = false;
    cutBased = iMissing;
    cutBasedHEEP = false;
    lostHits = iMissing; seedGain = iMissing; tightCharge = iMissing; jetIdx = iMissing;
    vidNestedWPBitmap = iMissing; vidNestedWPBitmapHEEP = iMissing;
    mvaIso = fMissing; mvaNoIso = fMissing; mvaTTH = fMissing;
    mvaIsoWP80 = false; mvaIsoWP90 = false; mvaIsoWPLoose = false;
    mvaNoIsoWP80 = false; mvaNoIsoWP90 = false; mvaNoIsoWPLoose = false;
    passLooseID = false; passHEEP = false;
    genPartFlav_truth = iMissing; genPartIdx_truth = iMissing;
}

void HNWR_BDT_presel_3SR::MuBranches::SetMissing() {
    *this = MuBranches();
    pt = fMissing; eta = fMissing; phi = fMissing; mass = fMissing; charge = fMissing;
    isFilled = false;
    dxy = fMissing; dxyErr = fMissing; dz = fMissing; dzErr = fMissing;
    ip3d = fMissing; sip3d = fMissing;
    pfRelIso03 = fMissing; pfRelIso04 = fMissing; miniPFRelIso = fMissing; tkRelIso = fMissing;
    isTracker = false; isGlobal = false; isStandalone = false;
    passLooseID = false; passTightID = false;
    tightCharge = iMissing; nTrackerLayers = iMissing;
    highPtId = iMissing; miniIsoId = iMissing; multiIsoId = iMissing; mvaMuId = iMissing;
    pfIsoId = iMissing; puppiIsoId = iMissing; tkIsoId = iMissing;
    softMva = fMissing; mvaLowPt = fMissing; mvaTTH = fMissing;
    jetIdx = iMissing; genPartFlav_truth = iMissing; genPartIdx_truth = iMissing;
}

void HNWR_BDT_presel_3SR::JetBranches::SetMissing() {
    *this = JetBranches();
    pt = fMissing; eta = fMissing; phi = fMissing; mass = fMissing; charge = fMissing;
    isFilled = false;
    rawPt = fMissing; originalPt = fMissing;
    deepJetB = fMissing; pnetB = fMissing; partB = fMissing;
    deepJetQG = fMissing; pnetQG = fMissing; partQG = fMissing;
    nConstituents = iMissing; nElectrons = iMissing; nMuons = iMissing; nSVs = iMissing;
    chHEF = fMissing; neHEF = fMissing; chEmEF = fMissing; neEmEF = fMissing; muEF = fMissing;
}

void HNWR_BDT_presel_3SR::FatJetBranches::SetMissing() {
    *this = FatJetBranches();
    pt = fMissing; eta = fMissing; phi = fMissing; mass = fMissing; charge = fMissing;
    isFilled = false;
    rawPt = fMissing; originalPt = fMissing; sdMass = fMissing; lsf3 = fMissing; area = fMissing;
    nConstituents = iMissing; nBHadrons = iMissing; nCHadrons = iMissing;
    pnetWithMassTvsQCD = fMissing; pnetWithMassWvsQCD = fMissing; pnetWithMassHbbvsQCD = fMissing;
    pnetXbbVsQCD = fMissing; pnetXqqVsQCD = fMissing; pnetQCD = fMissing;
}

void HNWR_BDT_presel_3SR::PairBranches::SetMissing() {
    m = fMissing; pt = fMissing; eta = fMissing; phi = fMissing;
    dR = fMissing; dPhi = fMissing; chargeProduct = fMissing;
    mjj = fMissing; ptjj = fMissing; dPhi_met = fMissing; met_mt = fMissing;
}

void HNWR_BDT_presel_3SR::BDTBranches::Reset() {
    evt.Reset();
    for (auto &b : ele) b.Reset();
    for (auto &b : mu) b.Reset();
    for (auto &b : jet) b.Reset();
    for (auto &b : fatjet) b.Reset();
    for (auto &b : extraLooseEle) b.Reset();
    for (auto &b : extraLooseMu) b.Reset();
    for (auto &b : vlExtraLooseEle) b.Reset();
    for (auto &b : vlExtraLooseMu) b.Reset();
    l1l2.Reset();
    l1l3.Reset();
    l2l3.Reset();
    // Only the VALUES are cleared: the keys own the addresses the RNTuple fields
    // were bound to, and a field cannot be rebound after booking.
    for (auto &kv : weightBranches) kv.second = 0.f;
}

// ===========================================================================
//  Field binding. One function per object block; the branch names built here
//  are exactly the strings v13's SetBranch calls produced.
// ===========================================================================
void HNWR_BDT_presel_3SR::BindElectron(RNTupleHandle &h, const std::string &p, EleBranches &b) {
    h.Field(p + "_pt", b.pt)
     .Field(p + "_eta", b.eta)
     .Field(p + "_phi", b.phi)
     .Field(p + "_mass", b.mass)
     .Field(p + "_charge", b.charge)
     .Field(p + "_isFilled", b.isFilled)
     .Field(p + "_dxy", b.dxy)
     .Field(p + "_dxyErr", b.dxyErr)
     .Field(p + "_dz", b.dz)
     .Field(p + "_dzErr", b.dzErr)
     .Field(p + "_ip3d", b.ip3d)
     .Field(p + "_sip3d", b.sip3d)
     .Field(p + "_pfRelIso03", b.pfRelIso03)
     .Field(p + "_miniPFRelIso", b.miniPFRelIso)
     .Field(p + "_scEta", b.scEta)
     .Field(p + "_deltaEtaInSC", b.deltaEtaInSC)
     .Field(p + "_deltaEtaInSeed", b.deltaEtaInSeed)
     .Field(p + "_deltaPhiInSC", b.deltaPhiInSC)
     .Field(p + "_deltaPhiInSeed", b.deltaPhiInSeed)
     .Field(p + "_ecalPFClusterIso", b.ecalPFClusterIso)
     .Field(p + "_hcalPFClusterIso", b.hcalPFClusterIso)
     .Field(p + "_dr03EcalRecHitSumEt", b.dr03EcalRecHitSumEt)
     .Field(p + "_dr03HcalDepth1TowerSumEt", b.dr03HcalDepth1TowerSumEt)
     .Field(p + "_dr03TkSumPt", b.dr03TkSumPt)
     .Field(p + "_dr03TkSumPtHEEP", b.dr03TkSumPtHEEP)
     .Field(p + "_hoe", b.hoe)
     .Field(p + "_sieie", b.sieie)
     .Field(p + "_eInvMinusPInv", b.eInvMinusPInv)
     .Field(p + "_energyErr", b.energyErr)
     .Field(p + "_r9", b.r9)
     .Field(p + "_rho", b.rho)
     .Field(p + "_scEtOverPt", b.scEtOverPt)
     .Field(p + "_convVeto", b.convVeto)
     .Field(p + "_cutBased", b.cutBased)
     .Field(p + "_cutBasedHEEP", b.cutBasedHEEP)
     .Field(p + "_lostHits", b.lostHits)
     .Field(p + "_seedGain", b.seedGain)
     .Field(p + "_tightCharge", b.tightCharge)
     .Field(p + "_jetIdx", b.jetIdx)
     .Field(p + "_vidNestedWPBitmap", b.vidNestedWPBitmap)
     .Field(p + "_vidNestedWPBitmapHEEP", b.vidNestedWPBitmapHEEP)
     .Field(p + "_mvaIso", b.mvaIso)
     .Field(p + "_mvaNoIso", b.mvaNoIso)
     .Field(p + "_mvaTTH", b.mvaTTH)
     .Field(p + "_mvaIsoWP80", b.mvaIsoWP80)
     .Field(p + "_mvaIsoWP90", b.mvaIsoWP90)
     .Field(p + "_mvaIsoWPLoose", b.mvaIsoWPLoose)
     .Field(p + "_mvaNoIsoWP80", b.mvaNoIsoWP80)
     .Field(p + "_mvaNoIsoWP90", b.mvaNoIsoWP90)
     .Field(p + "_mvaNoIsoWPLoose", b.mvaNoIsoWPLoose)
     .Field(p + "_passLooseID", b.passLooseID)
     .Field(p + "_passHEEP", b.passHEEP)
     .Field(p + "_genPartFlav_truth", b.genPartFlav_truth)
     .Field(p + "_genPartIdx_truth", b.genPartIdx_truth);
}

void HNWR_BDT_presel_3SR::BindMuon(RNTupleHandle &h, const std::string &p, MuBranches &b) {
    h.Field(p + "_pt", b.pt)
     .Field(p + "_eta", b.eta)
     .Field(p + "_phi", b.phi)
     .Field(p + "_mass", b.mass)
     .Field(p + "_charge", b.charge)
     .Field(p + "_isFilled", b.isFilled)
     .Field(p + "_dxy", b.dxy)
     .Field(p + "_dxyErr", b.dxyErr)
     .Field(p + "_dz", b.dz)
     .Field(p + "_dzErr", b.dzErr)
     .Field(p + "_ip3d", b.ip3d)
     .Field(p + "_sip3d", b.sip3d)
     .Field(p + "_pfRelIso03", b.pfRelIso03)
     .Field(p + "_pfRelIso04", b.pfRelIso04)
     .Field(p + "_miniPFRelIso", b.miniPFRelIso)
     .Field(p + "_tkRelIso", b.tkRelIso)
     .Field(p + "_isTracker", b.isTracker)
     .Field(p + "_isGlobal", b.isGlobal)
     .Field(p + "_isStandalone", b.isStandalone)
     .Field(p + "_passLooseID", b.passLooseID)
     .Field(p + "_passTightID", b.passTightID)
     .Field(p + "_tightCharge", b.tightCharge)
     .Field(p + "_nTrackerLayers", b.nTrackerLayers)
     .Field(p + "_highPtId", b.highPtId)
     .Field(p + "_miniIsoId", b.miniIsoId)
     .Field(p + "_multiIsoId", b.multiIsoId)
     .Field(p + "_mvaMuId", b.mvaMuId)
     .Field(p + "_pfIsoId", b.pfIsoId)
     .Field(p + "_puppiIsoId", b.puppiIsoId)
     .Field(p + "_tkIsoId", b.tkIsoId)
     .Field(p + "_softMva", b.softMva)
     .Field(p + "_mvaLowPt", b.mvaLowPt)
     .Field(p + "_mvaTTH", b.mvaTTH)
     .Field(p + "_jetIdx", b.jetIdx)
     .Field(p + "_genPartFlav_truth", b.genPartFlav_truth)
     .Field(p + "_genPartIdx_truth", b.genPartIdx_truth);
}

void HNWR_BDT_presel_3SR::BindJet(RNTupleHandle &h, const std::string &p, JetBranches &b) {
    h.Field(p + "_pt", b.pt)
     .Field(p + "_eta", b.eta)
     .Field(p + "_phi", b.phi)
     .Field(p + "_mass", b.mass)
     .Field(p + "_charge", b.charge)
     .Field(p + "_isFilled", b.isFilled)
     .Field(p + "_rawPt", b.rawPt)
     .Field(p + "_originalPt", b.originalPt)
     .Field(p + "_deepJetB", b.deepJetB)
     .Field(p + "_pnetB", b.pnetB)
     .Field(p + "_partB", b.partB)
     .Field(p + "_deepJetQG", b.deepJetQG)
     .Field(p + "_pnetQG", b.pnetQG)
     .Field(p + "_partQG", b.partQG)
     .Field(p + "_nConstituents", b.nConstituents)
     .Field(p + "_nElectrons", b.nElectrons)
     .Field(p + "_nMuons", b.nMuons)
     .Field(p + "_nSVs", b.nSVs)
     .Field(p + "_chHEF", b.chHEF)
     .Field(p + "_neHEF", b.neHEF)
     .Field(p + "_chEmEF", b.chEmEF)
     .Field(p + "_neEmEF", b.neEmEF)
     .Field(p + "_muEF", b.muEF);
}

void HNWR_BDT_presel_3SR::BindFatJet(RNTupleHandle &h, const std::string &p, FatJetBranches &b) {
    h.Field(p + "_pt", b.pt)
     .Field(p + "_eta", b.eta)
     .Field(p + "_phi", b.phi)
     .Field(p + "_mass", b.mass)
     .Field(p + "_charge", b.charge)
