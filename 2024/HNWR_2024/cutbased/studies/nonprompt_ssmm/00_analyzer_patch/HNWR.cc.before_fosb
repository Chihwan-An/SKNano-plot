    // SRChargeSplit bookkeeping (resolved: both lepton charges; boosted: leading lepton charge)
    bool srq_res_valid = false, srq_res_isEE = false; float srq_res_q1 = 0., srq_res_q2 = 0., srq_res_m = 0.;
