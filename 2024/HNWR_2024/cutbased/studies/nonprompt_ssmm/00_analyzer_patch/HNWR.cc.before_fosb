HNWR::HNWR() {}
HNWR::~HNWR() {}

// === TEMPORARY: theory / DY systematics disabled ==============================
// Set to false to restore. While true:
//   - initializeAnalyzer() loads data/config/MCLRSM_noTheoryDY.yaml instead of
//     MCLRSM.yaml, so the ScaleWeight_muF / ScaleWeight_muR / AlphaS and the
//     seven ZPtRw* nuisances are not scheduled at all.
//   - LoadDYCorrections() returns early, exactly as the NoDYCorr userflag does,
//     so C(genZpT), EW(genZpT) and R(jet pT) are all 1 and the per-bin
//     DYReshape nuisances iterate zero times.
// The two have to move together: ZPtRw_MC_stat / ZPtRwEW1 are the yaml entries
// that carry C and EW at nominal into the central weight, so dropping them from
// the yaml already removes the correction -- the early return just makes that
// explicit instead of implicit, and also switches R off.
static constexpr bool kTempNoTheoryDYSyst = false;
// =============================================================================

void HNWR::initializeAnalyzer() {
    // if signal ..  # 26
    // kfactor  # 51
    //
    // v13 cleared the owned object vectors here. The v15 equivalents are
    // default-constructed, event-scoped view collections; there is nothing to
    // clear, and holding one across the event boundary would throw on access.

    mu_set.Muon_Trigger.clear();
    mu_set.Muon_Trigger_Safe_Pt_Cut = 0.;
    el_set.Ele_Trigger.clear();
    el_set.Ele_Trigger_Safe_Pt_Cut = 0.;

    if ( DataEra=="2017")
    {
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_OldMu100", "HLT_TkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele35_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        el_set.Ele_Trigger_Safe_Pt_Cut = 38.;
    }

    if (DataEra == "2022")
    {
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_CascadeMu100", "HLT_HighPtTkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele30_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        el_set.Ele_Trigger_Safe_Pt_Cut = 35.;
    }
    if (DataEra == "2022EE")
    {
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_CascadeMu100", "HLT_HighPtTkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele30_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        el_set.Ele_Trigger_Safe_Pt_Cut = 35.;
    }
    if (DataEra == "2023")
    {
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_CascadeMu100", "HLT_HighPtTkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele30_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        // 35 = HLT_Ele30_WPTight_Gsf plateau. It sits below the 60 GeV lead-lepton
        // cut, so the lead cut is what binds and there is no dead zone -- the same
        // arrangement the muon side already has (safe 52 < lead 60).
        el_set.Ele_Trigger_Safe_Pt_Cut = 35.;
    }
    if (DataEra == "2023BPix")
    {
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_CascadeMu100", "HLT_HighPtTkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele30_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        el_set.Ele_Trigger_Safe_Pt_Cut = 35.;  // see 2023 above
    }
    if (DataEra == "2024")
    {
        // NanoAODv15 is only wired for 2024 in MyCorrection::GetEraConfig, so
        // this is the only era the ported analyzer can actually run on today.
        // Trigger set and plateau follow 2023/2023BPix.
        mu_set.Muon_Trigger = {"HLT_Mu50", "HLT_CascadeMu100", "HLT_HighPtTkMu100"};
        mu_set.Muon_Trigger_Safe_Pt_Cut = 52.;
        el_set.Ele_Trigger = {"HLT_Ele30_WPTight_Gsf","HLT_Photon200","HLT_Ele115_CaloIdVT_GsfTrkIdT"};
        el_set.Ele_Trigger_Safe_Pt_Cut = 35.;
    }

    myCorr = new MyCorrection(DataEra, DataPeriod, IsDATA ? DataStream : MCSample, IsDATA);

    // Initialize systematic helper
    if (IsDATA) {
        systHelper = std::make_unique<SystematicHelper>(
            Nano15Analyzers::ResolveModuleFile("HNWR/data/config/DataLRSM.yaml"), DataStream, DataEra);
    } else if (HasFlag("WeightSystOnly")) {
        // Weight-type nuisances only (no evtLoopAgain re-runs): one event loop.
        systHelper = std::make_unique<SystematicHelper>(
            Nano15Analyzers::ResolveModuleFile("HNWR/data/config/MCLRSM_weightonly.yaml"), MCSample, DataEra);
    } else {
        systHelper = std::make_unique<SystematicHelper>(
            Nano15Analyzers::ResolveModuleFile("HNWR/data/config/MCLRSM.yaml"), MCSample, DataEra);
    }

    NoDYCorr = HasFlag("NoDYCorr");
    RunXsecSyst = HasFlag("RunXsecSyst");
    ZptOnly = HasFlag("ZptOnly");
    ZptFxFxIncl = HasFlag("ZptFxFxIncl");
    ZptNJetAbs = HasFlag("ZptNJetAbs");
    ZptNJet = HasFlag("ZptNJet") || ZptNJetAbs;
    if (ZptNJet) std::cout << "[HNWR] userflag ZptNJet" << (ZptNJetAbs ? "Abs" : "")
                           << ": C(gen Z pT | GenJet multiplicity) from the FxFx/LO derivation" << std::endl;
    DYCRCharge = HasFlag("DYCRCharge");
    SRAll = HasFlag("SRAll");   // fill the resolved SR histograms for data too (default off; boosted SR was never guarded)
    SRChargeSplit = HasFlag("SRChargeSplit");
    BoostNoLSF = HasFlag("BoostNoLSF");
    if (BoostNoLSF) std::cout << "[HNWR] userflag BoostNoLSF: boosted SR / Flavor CR away fatjet taken from the full "
                                 "fatjet collection (no LSF3 > 0.75), LSF3 SF dropped, GlobalParT3 XWW scores stored" << std::endl;
    if (SRChargeSplit) std::cout << "[HNWR] userflag SRChargeSplit: charge-split SR WR-mass histograms (data only for negative leading lepton)" << std::endl;
    if (SRAll) std::cout << "[HNWR] userflag SRAll: resolved SR histograms are filled for DATA" << std::endl;
    DYCRStudy = HasFlag("DYCRStudy");
    DYCRSplit = HasFlag("DYCRSplit");
    WeightSystOnly = HasFlag("WeightSystOnly");
    if (DYCRSplit) std::cout << "[HNWR] userflag DYCRSplit: DYCR1_/DYCR2_ (m(ll) 60-100 / 100-150) histograms + 2D jet pT x mass + LowJet_ (0/1 jet, no AK8) m(ll) x pT(ll)" << std::endl;
    if (WeightSystOnly) std::cout << "[HNWR] userflag WeightSystOnly: MCLRSM_weightonly.yaml (no object-variation re-runs)" << std::endl;
    dycorr.flav_split = HasFlag("RFlav");   // per-flavour R curves (see HNWR.h)
    FOMode = HasFlag("FOMode");
    FODYCR = FOMode && HasFlag("FODYCR");
    if (FODYCR) std::cout << "[HNWR] userflag FODYCR: FO tree in the resolved DY CR window "
                             "(60 <= mll < 150, mlljj > 800), data and MC" << std::endl;
    if (FOMode && (!IsDATA || FODYCR) && !fFOBooked) {
        std::cout << "[HNWR] userflag FOMode: Central pass only; writes the FO_MM_resolved RNTuple "
                     "(two leading FO muons, TT/TL/LT/LL by TkRelIso downstream)" << std::endl;
        fFOHandle = Output().Book("Central/FO_MM_resolved", AnalyzerCore::RNTupleOutputProfile::Sparse);
        FOBranches &b = fFO;
        fFOHandle.Field("mu1_pt", b.mu1_pt).Field("mu1_eta", b.mu1_eta).Field("mu1_phi", b.mu1_phi)
            .Field("mu1_charge", b.mu1_charge).Field("mu1_tkRelIso", b.mu1_tkRelIso)
            .Field("mu2_pt", b.mu2_pt).Field("mu2_eta", b.mu2_eta).Field("mu2_phi", b.mu2_phi)
            .Field("mu2_charge", b.mu2_charge).Field("mu2_tkRelIso", b.mu2_tkRelIso)
            .Field("mu1_genPartFlav", b.mu1_genPartFlav).Field("mu1_genPartIdx", b.mu1_genPartIdx)
            .Field("mu1_genOrigin", b.mu1_genOrigin).Field("mu1_genMatchType", b.mu1_genMatchType)
            .Field("mu1_genMatchDR", b.mu1_genMatchDR)
            .Field("mu2_genPartFlav", b.mu2_genPartFlav).Field("mu2_genPartIdx", b.mu2_genPartIdx)
            .Field("mu2_genOrigin", b.mu2_genOrigin).Field("mu2_genMatchType", b.mu2_genMatchType)
            .Field("mu2_genMatchDR", b.mu2_genMatchDR)
            .Field("mll", b.mll).Field("mlljj", b.mlljj).Field("ptll", b.ptll)
            .Field("jet1_pt", b.jet1_pt).Field("jet1_eta", b.jet1_eta)
            .Field("jet2_pt", b.jet2_pt).Field("jet2_eta", b.jet2_eta)
            .Field("nJet", b.nJet).Field("nLooseMuon", b.nLooseMuon).Field("nLooseElectron", b.nLooseElectron)
            .Field("nTightMuon", b.nTightMuon).Field("nTightElectron", b.nTightElectron)
            .Field("weight", b.weight).Field("isoSF", b.isoSF).Field("dyR", b.dyR);
        fFOBooked = true;
    }
    if (NoDYCorr && ZptOnly) {
        // v13 printed to cerr and called exit(EXIT_FAILURE); the v15 job driver
        // collects a throw into its FailureContext instead.
        throw SKNano::ConfigError(
            "[HNWR] NoDYCorr and ZptOnly are mutually exclusive. Pass one or neither.");
    }

    LoadDYCorrections();
    LoadTheoryNormK();
}

// Reads the per-sample inclusive normalisation K_var used to make the four theory
// nuisances acceptance-only. Missing file or missing entry is NOT an error: the table
// only covers signal, and everything else keeps K = 1.
void HNWR::LoadTheoryNormK() {
    theoryK_scale.clear();
    theoryK_pdf.clear();
    if (IsDATA) return;

    const std::string path = Nano15Analyzers::OptionalModuleFile(
        "HNWR/data/TheoryNormK/" + std::string(DataEra.Data()) + "/TheoryNormK.json");
    if (path.empty()) {
        std::cout << "[HNWR] no theory-K table for " << DataEra
                  << " in the module data; theory nuisances stay un-normalised." << std::endl;
        return;
    }
    std::ifstream f(path);
    if (!f.is_open()) {
        std::cout << "[HNWR] no theory-K table at " << path
                  << "; theory nuisances stay un-normalised." << std::endl;
        return;
    }

    nlohmann::json j;
    try {
        f >> j;
    } catch (const std::exception &e) {
        throw SKNano::ConfigError("[HNWR] cannot parse " + path + ": " + e.what());
    }

    const std::string key = std::string(MCSample.Data());
    if (!j.contains("samples") || !j["samples"].contains(key)) {
        std::cout << "[HNWR] " << MCSample << " not in " << path
                  << " (background, or a signal alias without the full 103 PDF members); "
                  << "theory nuisances stay un-normalised." << std::endl;
        return;
    }

    const auto &s = j["samples"][key];
    if (s.contains("scale")) theoryK_scale = s["scale"].get<std::vector<float>>();
    if (s.contains("pdf"))   theoryK_pdf   = s["pdf"].get<std::vector<float>>();

    // Sizes must match what the weight targets index into. A short table would silently
    // fall back to K = 1 for the missing entries and mix normalised with un-normalised
    // members inside the same PDF envelope, so refuse it outright.
    if (theoryK_scale.size() != 9 || theoryK_pdf.size() != 103) {
        throw SKNano::ConfigError(
            "[HNWR] " + key + " in " + path + " has scale[" +
            std::to_string(theoryK_scale.size()) + "] pdf[" +
            std::to_string(theoryK_pdf.size()) + "], expected scale[9] pdf[103].");
    }

    std::cout << "[HNWR] theory-K loaded for " << MCSample << " (" << DataEra
              << "): muF idx3/idx5 = " << theoryK_scale[3] << "/" << theoryK_scale[5]
              << ", alphaS idx101/102 = " << theoryK_pdf[101] << "/" << theoryK_pdf[102]
              << ". Theory nuisances are acceptance-only." << std::endl;
}

float HNWR::GetTheoryNormK(const std::vector<float> &K, int idx) const {
    if (idx < 0 || idx >= static_cast<int>(K.size())) return 1.f;
    const float k = K[idx];
    return (std::isfinite(k) && k > 0.f) ? k : 1.f;
}

// Copied verbatim from v13 Analyzers/src/AnalyzerCore.cc:146-168; v15's
// AnalyzerCore kept GetScaleVariation but dropped this index helper.
//
// The index this returns is the one the K table (data/TheoryNormK/<era>/
// TheoryNormK.json, scale[9]) is laid out in, and since commit 6df8e69f
// AnalyzerCore::GetScaleVariation derives its slot the same way (3*iR + iF,
// nominal dropped only for 8-entry samples), so weight and normalisation refer
// to the same LHEScaleWeight member. Keep the two in step if either changes.
int HNWR::GetScaleVariationIndex(const MyCorrection::variation &muF_syst, const MyCorrection::variation &muR_syst) const {
    // Pythia-only samples (QCD EM/MuEnriched, bcToE) carry no LHE record at all.
    if(!nLHEScaleWeight.valid() || nLHEScaleWeight == 0) return -1;

    // (muF, muR) == (nom, nom) is the central value by definition: no index to read.
    if(muF_syst == MyCorrection::variation::nom && muR_syst == MyCorrection::variation::nom) return -1;

    // Standard NanoAOD LHEScaleWeight ordering: muR is the outer (slow) index,
    // muF the inner (fast) index, i.e. index = 3*iR + iF with i in {down,nom,up}.
    //   9-element samples INCLUDE the nominal (muR=1,muF=1) at index 4.
    //   8-element samples OMIT the nominal, so every entry from the nominal slot
    //     onward is shifted down by one.
    // Map each (muF, muR) request to (iF, iR) in {0,1,2} = {down, nom, up}.
    auto varIndex = [](const MyCorrection::variation &v) -> int {
        if(v == MyCorrection::variation::down) return 0;
        if(v == MyCorrection::variation::up)   return 2;
        return 1; // nom
    };
    const int idx = 3 * varIndex(muR_syst) + varIndex(muF_syst);

    if(nLHEScaleWeight == 9) return idx;                    // direct 3x3 grid
    if(nLHEScaleWeight == 8) return idx > 4 ? idx - 1 : idx; // nominal slot removed
    return -1;                                              // unexpected multiplicity
}

// eta MUST be the supercluster eta (ElectronView::ScEta()), not the track eta: the
// barrel/endcap split is at the SC crack edge |eta| = 1.4442.
// Constant HLT SF from the EGM high-pT electron trigger T&P (fit range pT > 130 GeV):
//   era        barrel          endcap
//   2022       0.995 +- 0.004  0.991 +- 0.009
//   2022EE     0.990 +- 0.007  0.981 +- 0.017
//   2023       0.992 +- 0.006  0.979 +- 0.019
//   2023BPix   0.993 +- 0.001  0.978 +- 0.019
// ---------------------------------------------------------------------------
// DY corrections: C(gen Z pT), EW(gen Z pT) and R(reco jet pT)
// ---------------------------------------------------------------------------
namespace {
// Paths are overridable so a re-derived correction can be tested without a
// rebuild. Defaults point at the staging area the derivation writes to.
const char *kDefaultZptFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt/dy_zpt_nlo_lo.root";
// R re-derived on top of the per-multiplicity C (make_dy_cr_datamc.py --derive-R): the shipped R
// was measured against the powheg-based C and does not belong with this one.
const char *kDefaultRFileNJet =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/jetpt/zptnjet/dy_jetpt_ratio.root";
const char *kDefaultRFileNJetAbs =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/jetpt/zptnjet_abs/dy_jetpt_ratio.root";
const char *kDefaultZptFxFxInclFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt/dy_zpt_fxfx_lo_incl.root";
const char *kDefaultRFileFxFxIncl =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/jetpt/zptfxfxincl/dy_jetpt_ratio.root";
const char *kDefaultZptNJetFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt/dy_zpt_fxfx_lo_njet.root";
const char *kDefaultZptNJetAbsFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt/dy_zpt_fxfx_lo_njet_abs.root";
const char *kDefaultRFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/jetpt/dy_jetpt_ratio.root";
// NLO EW correction EW(genZpT), arXiv:1705.04664, copied verbatim from
// SKFlatAnalyzer data/Run2Legacy_v4/2018/HNWRDYPtReweight/ZPtEWCorr.root
// (the 2016/2017/2018 files are byte-identical: pure theory, era-independent,
// so unlike C and R there is no per-era directory inside).
const char *kDefaultEWFile =
    "/data9/Users/achihwan/nano15/SKNanoAnalyzer/Nano15_Analyzers/HNWR/data/"
    "corrections/zpt_ew/ZPtEWCorr.root";
// GenPart status-62 Z, else status-1 OSSF e/mu pair (HNWRDY::FindGenZ),
// LHE_HT > 40 -- the variant C is delivered in since the 2024 derivation.
const char *kZptVariant = "Zpt_genZ_HT40";

// Read a TH1 into (edges, values, errors).
bool ReadTH1(TFile *f, const TString &path, std::vector<double> &edges,
             std::vector<double> &vals, std::vector<double> *errs = nullptr) {
    TH1 *h = dynamic_cast<TH1 *>(f->Get(path));
    if (!h) return false;
    const int n = h->GetNbinsX();
    edges.resize(n + 1);
    vals.resize(n);
    if (errs) errs->resize(n);
    for (int i = 1; i <= n; i++) {
        edges[i - 1] = h->GetBinLowEdge(i);
        vals[i - 1] = h->GetBinContent(i);
        if (errs) (*errs)[i - 1] = h->GetBinError(i);
    }
    edges[n] = h->GetBinLowEdge(n) + h->GetBinWidth(n);
    return true;
}

int FindBin(const std::vector<double> &edges, double x) {
    if (edges.size() < 2) return -1;
    if (x >= edges.back()) return static_cast<int>(edges.size()) - 2;  // clamp
    if (x < edges.front()) return 0;
    int i = 0;
    while (i + 2 < static_cast<int>(edges.size()) && x >= edges[i + 1]) i++;
    return i;
}
}  // namespace

bool HNWR::IsDYSample() const {
    // The LO HT-binned madgraphMLM DY set the analysis uses as its DY
    // background and that C corrects towards NLO: v13 aliases DYMLL<m>HT<h>,
    // v15/2024 aliases DYto2L_MLL<m>_HT<h>. The NLO mass-binned DYto2E/DYto2Mu
    // samples are the numerator of C and must not match here.
    if (IsDATA) return false;
    if (MCSample.Contains("DYMLL")) return true;
    return MCSample.Contains("DYto2L_MLL") && MCSample.Contains("_HT");
}

void HNWR::LoadDYCorrections() {
    const bool flavSplit = dycorr.flav_split;   // set from the RFlav userflag before this call
    dycorr = DYCorrections();
    dycorr.flav_split = flavSplit;
    if (!IsDYSample()) return;
    // TEMPORARY: see kTempNoTheoryDYSyst above.
    if (kTempNoTheoryDYSyst) {
        std::cout << "[HNWR] DY corrections OFF for " << MCSample << " / " << DataEra
                  << " (C=off EW=off R=off): this build runs without the theory and DY "
                     "systematics (kTempNoTheoryDYSyst)." << std::endl;
        return;
    }
    if (NoDYCorr || std::getenv("DY_NO_CORRECTION")) {
        std::cout << "[HNWR] DY corrections OFF for " << MCSample
                  << " / " << DataEra << " (C=off R=off), requested by "
                  << (NoDYCorr ? "userflag NoDYCorr" : "DY_NO_CORRECTION") << "." << std::endl;
        return;
    }

    // --- C
    const char *zenv = std::getenv("DY_ZPT_CORRECTION");
    const TString zpath = zenv ? zenv : (ZptFxFxIncl ? kDefaultZptFxFxInclFile : kDefaultZptFile);
    std::unique_ptr<TFile> zf(TFile::Open(zpath));
    if (!zf || zf->IsZombie())
        throw SKNano::ConfigError("[HNWR] cannot open " + std::string(zpath.Data()));
    // Era-specific. There is no combined fallback: reweighting one era with
    // another's curve would be silently wrong.
    const TString zdir = TString(kZptVariant) + "/" + DataEra + "/";
    for (const char *key : {"ZPTReweight", "ZPTReweight_Up", "ZPTReweight_Down",
                            "ZPTReweight_QCDScaleUp", "ZPTReweight_QCDScaleDown",
                            "ZPTReweight_QCDPDFErrorUp", "ZPTReweight_QCDPDFErrorDown",
                            "ZPTReweight_QCDPDFAlphaSUp", "ZPTReweight_QCDPDFAlphaSDown"}) {
        std::vector<double> e, v, s;
        if (!ReadTH1(zf.get(), zdir + key, e, v, &s)) {
            throw SKNano::ConfigError(
                "[HNWR] " + std::string((zdir + key).Data()) + " missing in " +
                std::string(zpath.Data()) + ". C is delivered per era; for a missing era run "
                "Nano15_Analyzers/HNWR/scripts/run_dy_corrections.sh (steps 1-2).");
        }
        if (dycorr.zpt_edges.empty()) dycorr.zpt_edges = e;
        dycorr.zpt[key] = v;
        // The MC statistical error of C is carried by the bin errors of the
        // nominal histogram alone; every other key is written with zero errors
        // (make_dy_zpt_nlo_lo.py:597-603). ZPTReweight_Up/Down is the quadrature
        // sum of the three theory groups and contains no statistical component,
        // which is why the ZPtRw_MC_stat nuisance is built from this instead.
        if (std::string(key) == "ZPTReweight") dycorr.zpt_stat = s;
    }

    // --- R. Rebinned curves only; the bin error is sigma_R, the single band
    // that already contains statistics and the non-DY cross sections.
    // The ZptOnly userflag skips R entirely rather than loading it and
    // multiplying by 1: n_nuis_res/boo then stay 0, so the DYReshape nuisances
    // disappear too, which is what "R is not applied" has to mean.
    if (ZptNJet) {
        const char *nenv = std::getenv("DY_ZPT_NJET_CORRECTION");
        const TString npath = nenv ? nenv : (ZptNJetAbs ? kDefaultZptNJetAbsFile : kDefaultZptNJetFile);
        std::unique_ptr<TFile> nf(TFile::Open(npath));
        if (!nf || nf->IsZombie())
            throw SKNano::ConfigError("[HNWR] ZptNJet: cannot open " + std::string(npath.Data()));
        const char *tags[3] = {"GenJ0", "GenJ1", "GenJ2"};
        for (int j = 0; j < 3; j++) {
            const TString ndir = TString("Zpt_genZ_HT40_") + tags[j] + "/" + DataEra + "/";
            for (const char *key : {"ZPTReweight", "ZPTReweight_Up", "ZPTReweight_Down",
                                    "ZPTReweight_QCDScaleUp", "ZPTReweight_QCDScaleDown",
                                    "ZPTReweight_QCDPDFErrorUp", "ZPTReweight_QCDPDFErrorDown",
                                    "ZPTReweight_QCDPDFAlphaSUp", "ZPTReweight_QCDPDFAlphaSDown"}) {
                std::vector<double> e, v, st;
                if (!ReadTH1(nf.get(), ndir + key, e, v, &st))
                    throw SKNano::ConfigError("[HNWR] ZptNJet: " + std::string((ndir + key).Data()) +
                                              " missing in " + std::string(npath.Data()));
                if (dycorr.nj[j].edges.empty()) dycorr.nj[j].edges = e;
                dycorr.nj[j].vals[key] = v;
                if (std::string(key) == "ZPTReweight") dycorr.nj[j].stat = st;
            }
        }
        dycorr.by_njet = true;
        std::cout << "[HNWR] ZptNJet: C per GenJet multiplicity from " << npath << std::endl;
    }

    const char *renv = std::getenv("DY_JETPT_CORRECTION");
    const TString rpath = ZptOnly ? "(not loaded)"
                        : (renv ? renv : (ZptNJetAbs ? kDefaultRFileNJetAbs
                                          : (ZptNJet ? kDefaultRFileNJet
                                             : (ZptFxFxIncl ? kDefaultRFileFxFxIncl : kDefaultRFile))));
    if (!ZptOnly) {
        std::unique_ptr<TFile> rf(TFile::Open(rpath));
        if (!rf || rf->IsZombie())
            throw SKNano::ConfigError("[HNWR] cannot open " + std::string(rpath.Data()));
        // Era-specific, like C. The "_comb" in the directory name is the flavour
        // sum: ee and mumu agree within one sigma, so no flavour-split correction
        // is used. The era, however, is not summed over -- in the resolved category
        // the four eras scatter around a common R by chi2/ndf = 3.3, too much for
        // their statistics, so a combined curve would be wrong by more than its own
        // band (make_dy_jetpt_ratio.py writes that test into its run log). The file
        // still carries a "combined" key for that comparison; reading it here would
        // silently apply a four-era average.
        for (int cat = 0; cat < 2; cat++) {
            const TString dir =
                TString(cat == 0 ? "resolved_comb/" : "boosted_comb/") + DataEra + "/";
            std::vector<double> &edges = cat == 0 ? dycorr.r_edges_res : dycorr.r_edges_boo;
            std::vector<double> &vals = cat == 0 ? dycorr.r_val_res : dycorr.r_val_boo;
            std::vector<double> &sigs = cat == 0 ? dycorr.r_sig_res : dycorr.r_sig_boo;
            // make_dy_jetpt_ratio.py writes "rebinned" as a directory, and puts
            // sigma_R (= R_total, stat + non-DY xsec) into R_nominal's bin errors.
            if (!ReadTH1(rf.get(), dir + "rebinned/R_nominal", edges, vals, &sigs)) {
                throw SKNano::ConfigError(
                    "[HNWR] " + std::string(dir.Data()) + "rebinned/R_nominal missing in " +
                    std::string(rpath.Data()));
            }
            int n = 0;
            for (double v : vals) if (std::isfinite(v) && v > 0.) n++;
            (cat == 0 ? dycorr.n_nuis_res : dycorr.n_nuis_boo) = n;
        }
        // RFlav: the per-flavour curves next to the combined ones. Same binning
        // (same rebinned edges) is assumed, so n_nuis_* stays as counted above.
        if (dycorr.flav_split) {
            for (int cat = 0; cat < 2; cat++) {
                for (int fl = 1; fl <= 2; fl++) {
                    const TString dir = TString(cat == 0 ? "resolved_" : "boosted_") +
                                        (fl == 1 ? "EE/" : "MM/") + DataEra + "/";
                    std::vector<double> &edges = cat == 0 ? dycorr.r_edges_res_f[fl] : dycorr.r_edges_boo_f[fl];
                    std::vector<double> &vals = cat == 0 ? dycorr.r_val_res_f[fl] : dycorr.r_val_boo_f[fl];
                    std::vector<double> &sigs = cat == 0 ? dycorr.r_sig_res_f[fl] : dycorr.r_sig_boo_f[fl];
                    if (!ReadTH1(rf.get(), dir + "rebinned/R_nominal", edges, vals, &sigs))
                        throw SKNano::ConfigError("[HNWR] RFlav: " + std::string(dir.Data()) +
                                                  "rebinned/R_nominal missing in " + std::string(rpath.Data()));
                }
            }
            std::cout << "[HNWR] RFlav: per-flavour R curves loaded (resolved/boosted x EE/MM)" << std::endl;
        }
    }

    // --- EW. Applied alongside C exactly as in SKFlat HNWRAnalyzer: whenever
    // the Z-pT correction is on, EW is on (ZptOnly turns off R, not EW). The
    // nominal sits in the bin CONTENTS of hist_v; the three uncertainty sources
    // of arXiv:1705.04664 sit in the bin ERRORS of hist_e1/e2/e3 (their
    // contents duplicate hist_v and are not read).
    const char *ewenv = std::getenv("DY_ZPT_EW_CORRECTION");
    const TString ewpath = ewenv ? ewenv : kDefaultEWFile;
    std::unique_ptr<TFile> ewf(TFile::Open(ewpath));
    if (!ewf || ewf->IsZombie())
        throw SKNano::ConfigError("[HNWR] cannot open " + std::string(ewpath.Data()));
    {
        std::vector<double> dummy_e, dummy_v;
        if (!ReadTH1(ewf.get(), "hist_v", dycorr.ew_edges, dycorr.ew_val) ||
            !ReadTH1(ewf.get(), "hist_e1", dummy_e, dummy_v, &dycorr.ew_e1) ||
            !ReadTH1(ewf.get(), "hist_e2", dummy_e, dummy_v, &dycorr.ew_e2) ||
            !ReadTH1(ewf.get(), "hist_e3", dummy_e, dummy_v, &dycorr.ew_e3)) {
            throw SKNano::ConfigError("[HNWR] hist_v/e1/e2/e3 missing in " +
                                      std::string(ewpath.Data()));
        }
    }

    dycorr.loaded = true;
    dycorr.apply = true;
    // With ZptOnly the R curves were never read, so n_nuis_res/boo stay 0 and
    // the DYReshape nuisance loops iterate zero times. That is the intent: no R
    // means no R nuisances.
    dycorr.apply_r = !ZptOnly;
    dycorr.apply_ew = true;
    std::cout << "[HNWR] DY corrections on for " << MCSample << " / "
              << DataEra << ": C=on R=" << (dycorr.apply_r ? "on" : "off (userflag ZptOnly)")
              << " EW=on, C from " << zpath << " (" << dycorr.zpt_edges.size() - 1
              << " bins), R from " << rpath << " (" << dycorr.n_nuis_res
              << " resolved + " << dycorr.n_nuis_boo << " boosted nuisance bins)"
              << ", EW from " << ewpath << " (" << dycorr.ew_edges.size() - 1
              << " bins)" << std::endl;
}

float HNWR::GetGenZpT() const {
    // One definition for derivation and application: HNWRDY::FindGenZ
    // (GenPart status-62 Z, else the leading status-1 OSSF e/mu pair).
    // -1 when neither exists; every DY target then returns 1.
    return HNWRDY::FindGenZ(gen_set.gens).pt;
}

float HNWR::GetZptWeight(float gen_zpt, const std::string &key) const {
    if (!dycorr.apply || gen_zpt < 0.) return 1.f;
    const auto &vals = dycorr.by_njet ? dycorr.nj[std::min(dy_n_genjet, 2)].vals : dycorr.zpt;
    const auto &edges = dycorr.by_njet ? dycorr.nj[std::min(dy_n_genjet, 2)].edges : dycorr.zpt_edges;
    auto it = vals.find(key);
    if (it == vals.end() || it->second.empty()) return 1.f;
    const int i = FindBin(edges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(it->second.size())) return 1.f;
    const double c = it->second[i];
    if (!std::isfinite(c) || c <= 0.) return 1.f;
    return static_cast<float>(c);
}

float HNWR::GetZptStat(float gen_zpt) const {
    if (!dycorr.apply || gen_zpt < 0.) return 0.f;
    const auto &zstat = dycorr.by_njet ? dycorr.nj[std::min(dy_n_genjet, 2)].stat : dycorr.zpt_stat;
    const auto &zedges = dycorr.by_njet ? dycorr.nj[std::min(dy_n_genjet, 2)].edges : dycorr.zpt_edges;
    if (zstat.empty()) return 0.f;
    const int i = FindBin(zedges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(zstat.size())) return 0.f;
    const double s = zstat[i];
    // NaN where C is NaN (empty LO denominator). GetZptWeight falls back to 1
    // there, so the variation has to be 0 to stay on top of that fallback.
    if (!std::isfinite(s) || s < 0.) return 0.f;
    return static_cast<float>(s);
}

float HNWR::GetZptEW(float gen_zpt, int which, int dir) const {
    if (!dycorr.apply || !dycorr.apply_ew || gen_zpt < 0.) return 1.f;
    if (dycorr.ew_val.empty()) return 1.f;
    // FindBin clamps both sides, which reproduces the SKFlat clipping
    // (pT<30 -> first bin, pT>=6500 -> last bin) without explicit ifs.
    const int i = FindBin(dycorr.ew_edges, gen_zpt);
    if (i < 0 || i >= static_cast<int>(dycorr.ew_val.size())) return 1.f;
    double v = dycorr.ew_val[i];
    if (!std::isfinite(v) || v <= 0.) return 1.f;
    if (which >= 1 && which <= 3 && dir != 0) {
        const std::vector<double> &errs =
            which == 1 ? dycorr.ew_e1 : which == 2 ? dycorr.ew_e2 : dycorr.ew_e3;
        if (i < static_cast<int>(errs.size()) && std::isfinite(errs[i]))
            v += dir * errs[i];
        // Same guard as the C stat variation: never hand back <= 0, that
        // would delete the event instead of down-weighting it.
        if (v <= 0.) v = 1e-3;
    }
    return static_cast<float>(v);
}

float HNWR::GetJetPtR(bool resolved, float pt, int nuis_bin, int dir, int flav) const {
    if (!dycorr.apply || !dycorr.apply_r || pt < 0.) return 1.f;
    const bool useFlav = dycorr.flav_split && (flav == 1 || flav == 2);
    const std::vector<double> &edges = useFlav ? (resolved ? dycorr.r_edges_res_f[flav] : dycorr.r_edges_boo_f[flav])
                                               : (resolved ? dycorr.r_edges_res : dycorr.r_edges_boo);
    const std::vector<double> &vals = useFlav ? (resolved ? dycorr.r_val_res_f[flav] : dycorr.r_val_boo_f[flav])
                                              : (resolved ? dycorr.r_val_res : dycorr.r_val_boo);
    const std::vector<double> &sigs = useFlav ? (resolved ? dycorr.r_sig_res_f[flav] : dycorr.r_sig_boo_f[flav])
                                              : (resolved ? dycorr.r_sig_res : dycorr.r_sig_boo);
    if (vals.empty()) return 1.f;
    const int i = FindBin(edges, pt);
    if (i < 0 || i >= static_cast<int>(vals.size())) return 1.f;

    double r = vals[i];
    // Undefined bins are NaN in the file. 1.0 means "no correction"; 0 would
    // delete the DY prediction instead.
    if (!std::isfinite(r) || r <= 0.) return 1.f;

    // Per-bin nuisance: only the requested bin moves.
    if (nuis_bin >= 0 && nuis_bin == i && dir != 0) {
        const double s = (i < static_cast<int>(sigs.size()) && std::isfinite(sigs[i]))
                             ? sigs[i] : 0.;
        r += (dir > 0 ? s : -s);
        if (!std::isfinite(r) || r <= 0.) return 1.f;
    }
    return static_cast<float>(r);
}

float HNWR::GetElectronTriggerSF_TnP(double eta, double pt, MyCorrection::variation var) const {
    // 2024 is binned in (signed SC eta, pT); the earlier eras only ever had a
    // barrel/endcap constant from the pT > 130 fit.
    if (DataEra == "2024") {
        const int syst = (var == MyCorrection::variation::up)     ?  1
                       : (var == MyCorrection::variation::down)  ? -1 : 0;
        return HNWRTrigSF::Get2024(eta, pt, syst);
    }

    const bool isBarrel = std::fabs(eta) < 1.4442;

    float sf, err;
    if      (DataEra == "2022")     { sf = isBarrel ? 0.995f : 0.991f; err = isBarrel ? 0.004f : 0.009f; }
    else if (DataEra == "2022EE")   { sf = isBarrel ? 0.990f : 0.981f; err = isBarrel ? 0.007f : 0.017f; }
    else if (DataEra == "2023")     { sf = isBarrel ? 0.992f : 0.979f; err = isBarrel ? 0.006f : 0.019f; }
    else if (DataEra == "2023BPix") { sf = isBarrel ? 0.993f : 0.978f; err = isBarrel ? 0.001f : 0.019f; }
    else return 1.0; // no measurement for this era (e.g. 2017)

    if (var == MyCorrection::variation::up)   return sf + err;
    if (var == MyCorrection::variation::down) return sf - err;
    return sf;
}

// eta MUST be the supercluster eta (ElectronView::ScEta()): the EGM SF is binned in
// signed SC eta with crack bins at |eta| 1.4442-1.566.
//
// HEEP ID scale factor from the EGM heep-id branch of electron.json.gz
// (era yml entry "electron_heep", MyCorrection::GetElectronHEEPIDSF; pt binned
// from 35 GeV, clamped there). Eras without that file keep the v13-era
// behaviour of returning 1.0 and say so once, so the ElectronID nuisance is a
// no-op only where the input is genuinely missing.
float HNWR::GetElectronHEEPIDSF_TnP(double eta, double pt, MyCorrection::variation var) const {
    if (myCorr && myCorr->HasElectronHEEPIDSF())
        return myCorr->GetElectronHEEPIDSF(static_cast<float>(eta), static_cast<float>(pt), var);
    if (!fWarnedNoHEEPIDSF) {
        std::cerr << "[HNWR::GetElectronHEEPIDSF_TnP] WARNING: no HEEP electron ID scale "
                  << "factor configured for era " << DataEra
                  << " (era yml has no electron_heep entry). Returning 1.0; "
                  << "the ElectronID nuisance is a no-op." << std::endl;
        fWarnedNoHEEPIDSF = true;
    }
    return 1.0;
}

// log10 of a tagger score for the BoostNoLSF scan histograms, clamped into the [1e-8, 1] axis;
// a score of 0 (or an unset -1) lands in the first bin.
static float Log10Score(float score) {
    if (!(score > 0.f)) return -8.f;
    return std::max(-8.f, float(std::log10(std::min(score, 1.f))));
}

// LSF3 cut efficiency scale factor, keyed by the flavor of the lepton inside the fatjet:
//   muon-in-fatjet     (measured in the e-mujet flavor CR): 1.06 +- 0.10
//   electron-in-fatjet (measured in the mu-ejet flavor CR): 1.11 +- 0.11
// Applied only in the boosted SR (SR MM -> mujet, SR EE -> ejet) and the boosted flavor CR.
float HNWR::GetLSFSF(bool muonInFatJet, MyCorrection::variation var) const {
    // userflag BoostNoLSF drops the LSF3 cut, so its cut-efficiency SF (and its nuisance) go with it.
    if (BoostNoLSF) return 1.f;
    const float sf  = muonInFatJet ? 1.06f : 1.11f;
    const float err = muonInFatJet ? 0.10f : 0.11f;
    if (var == MyCorrection::variation::up)   return sf + err;
    if (var == MyCorrection::variation::down) return sf - err;
    return sf;
}

float HNWR::GetMuonHighPtTriggerSF(const std::vector<const LepCand *> &muons,
                                   MyCorrection::variation var) const {
    float weight = 1.f;
    for (const auto *mu : muons) {
        if (!mu) continue;
        weight *= myCorr->GetMuonHighPtSF("NUM_HLT_DEN_HighPtLooseRelIsoProbes",
                                          mu->Eta(), mu->sfPt, var);
    }
    return weight;
}

// ---------------------------------------------------------------------------
// Object variation lanes
// ---------------------------------------------------------------------------
HNWR::ObjectLanes HNWR::LanesForSystematic(const std::string &this_syst) const {
    ObjectLanes lanes;
    // v13 wrapped the whole variation block in `if (!IsDATA)`, so data always
    // ran the nominal collection. Keep that: the muon/electron/fat-jet lanes are
    // identical to nominal for data anyway, but the jet lanes are not.
    if (IsDATA) return lanes;

    auto has = [&](const char *needle) {
        return this_syst.find(needle) != std::string::npos;
    };

    // JER: ONE nuisance for AK4, AK8 and the SoftDrop subjets. The AK8 JER scale
    // factors in fatJet_jerc.json.gz are byte-identical to the AK4 ones in all four
    // Run3 eras - the POG never measured AK8 separately, it copied AK4 - so the
    // quantity the nuisance actually varies is the same measurement. Only the nominal
    // PtResolution curve differs, and only for 2023/2023BPix. Splitting them into
    // JER / FatJetJER was decorrelating a source from itself.
    //
    // JES: likewise ONE nuisance. The AK8 Total uncertainty is also byte-identical to
    // the AK4 one in all four eras, and both the AK4 and AK8 lanes resolve to the POG
    // Total key, so the two collections move by the same relative amount.
    //
    // The nominal JER smearing is NOT a variation: it is applied on every MC pass by
    // the nominal lane (JetView::SmearedPtNominal / FatJetView::SmearedPtNominal /
    // FatJetView::SDMassNominal). NanoAOD ships unsmeared, so leaving Central on the
    // raw or JEC-only momentum would make both JER variations shift in the same
    // direction instead of bracketing Central. The soft-drop mass carries the subjet
    // JERC in the same way -- SDMass() is raw and must never be used here, because
    // m_SD > 40 GeV is a selection cut and roughly 11-16% of the selected yield sits
    // within 10 GeV above it.
    if      (has("JER_Up"))   lanes.jer = MyCorrection::variation::up;
    else if (has("JER_Down")) lanes.jer = MyCorrection::variation::down;
    else if (has("JES_Up"))   lanes.jes = MyCorrection::variation::up;
    else if (has("JES_Down")) lanes.jes = MyCorrection::variation::down;

    // Muon scale: the high-pT scale lanes carry the medium-pT scale uncertainty
    // below 200 GeV (MUO POG scale/smearing where the era configures it, the
    // Rochester error otherwise) and the Generalized-Endpoint kappa uncertainty
    // above, so one nuisance covers both regimes -- the same split v13's
    // MomentumScaleUp/Down had.
    if      (has("MuonScale_Up"))   lanes.muon = ObjectLanes::MuonLane::ScaleUp;
    else if (has("MuonScale_Down")) lanes.muon = ObjectLanes::MuonLane::ScaleDown;
    // Muon resolution: MC-only. Below 200 GeV it is the POG scale/smearing
    // resolution uncertainty (identically zero for Rochester eras); above, the
    // extra high-pT smearing (POG resolution deck 2024/06/03), one-sided in the
    // barrel for 2022 and 2023BPix, where the nominal smearing is 0 and a
    // Gaussian cannot sharpen MC.
    else if (has("MuonRes_Up"))     lanes.muon = ObjectLanes::MuonLane::ResUp;
    else if (has("MuonRes_Down"))   lanes.muon = ObjectLanes::MuonLane::ResDown;

    if      (has("ElectronScale_Up"))   lanes.electron = ObjectLanes::ElectronLane::ScaleUp;
    else if (has("ElectronScale_Down")) lanes.electron = ObjectLanes::ElectronLane::ScaleDown;
    else if (has("ElectronRes_Up"))     lanes.electron = ObjectLanes::ElectronLane::SmearUp;
    else if (has("ElectronRes_Down"))   lanes.electron = ObjectLanes::ElectronLane::SmearDown;

    return lanes;
}

float HNWR::MuonLanePt(const MuonView &mu, const ObjectLanes &lanes) const {
    // This analysis uses TuneP high-pT muons throughout, so every lane is the
    // high-pT one (below 200 GeV it mirrors the Rochester treatment).
    switch (lanes.muon) {
    case ObjectLanes::MuonLane::ScaleUp:   return mu.HighPtScaleUp();
    case ObjectLanes::MuonLane::ScaleDown: return mu.HighPtScaleDown();
    case ObjectLanes::MuonLane::ResUp:     return mu.HighPtResUp();
    case ObjectLanes::MuonLane::ResDown:   return mu.HighPtResDown();
    case ObjectLanes::MuonLane::Nominal:   break;
    }
    return mu.HighPtPt();
}

float HNWR::ElectronLanePt(const ElectronView &el, const ObjectLanes &lanes) const {
    switch (lanes.electron) {
    case ObjectLanes::ElectronLane::ScaleUp:   return el.ScaleUpPt();
    case ObjectLanes::ElectronLane::ScaleDown: return el.ScaleDownPt();
    case ObjectLanes::ElectronLane::SmearUp:   return el.SmearUpPt();
    case ObjectLanes::ElectronLane::SmearDown: return el.SmearDownPt();
    case ObjectLanes::ElectronLane::Nominal:   break;
    }
    return el.Pt();
}

float HNWR::JetLanePt(const JetView &jet, const ObjectLanes &lanes) const {
    if (IsDATA) return jet.CorrectedPt();
    if (lanes.jes == MyCorrection::variation::up)   return jet.JesPtUp();
    if (lanes.jes == MyCorrection::variation::down) return jet.JesPtDown();
    if (lanes.jer == MyCorrection::variation::up)   return jet.SmearedPtUp();
    if (lanes.jer == MyCorrection::variation::down) return jet.SmearedPtDown();
    return jet.SmearedPtNominal();
}

float HNWR::FatJetLanePt(const FatJetView &fj, const ObjectLanes &lanes) const {
    // Must match AnalyzerCore::SelectFatJets exactly, or the pt used downstream
    // would not be the pt the selection cut on.
    if (IsDATA) return fj.CorrectedPt();
    if (lanes.jes == MyCorrection::variation::up)   return fj.JesPtUp();
    if (lanes.jes == MyCorrection::variation::down) return fj.JesPtDown();
    if (lanes.jer == MyCorrection::variation::up)   return fj.SmearedPtUp();
    if (lanes.jer == MyCorrection::variation::down) return fj.SmearedPtDown();
    return fj.SmearedPtNominal();
}

float HNWR::FatJetLaneMass(const FatJetView &fj, const ObjectLanes &lanes) const {
    if (IsDATA) return fj.CorrectedMass();
    if (lanes.jes == MyCorrection::variation::up)   return fj.JesMassUp();
    if (lanes.jes == MyCorrection::variation::down) return fj.JesMassDown();
    if (lanes.jer == MyCorrection::variation::up)   return fj.SmearedMassUp();
    if (lanes.jer == MyCorrection::variation::down) return fj.SmearedMassDown();
    return fj.SmearedMassNominal();
}

float HNWR::FatJetLaneSDMass(const FatJetView &fj, const ObjectLanes &lanes) const {
    // JME recommendation (CMS Talk, "AK8 Puppi Jet JERC for Soft Drop Mass", Jan 2026):
    // m_SD is corrected by applying the AK4 JERC to the subjets and recomputing their
    // invariant mass. FatJetView::SDMass() is the raw NanoAOD value and is never right
    // here; SDMassNominal() already carries the nominal subjet smearing, which is what
    // v13 got from VarySoftDropMass(..., nom, "total", false) on every pass.
    if (IsDATA) return fj.SDMassNominal();
    if (lanes.jes == MyCorrection::variation::up)   return fj.SDMassJesUp();
    if (lanes.jes == MyCorrection::variation::down) return fj.SDMassJesDown();
    if (lanes.jer == MyCorrection::variation::up)   return fj.SDMassJerUp();
    if (lanes.jer == MyCorrection::variation::down) return fj.SDMassJerDown();
    return fj.SDMassNominal();
}

TLorentzVector HNWR::FatJetLaneP4(const FatJetView &fj, const ObjectLanes &lanes) const {
    TLorentzVector v;
    v.SetPtEtaPhiM(FatJetLanePt(fj, lanes), fj.Eta(), fj.Phi(), FatJetLaneMass(fj, lanes));
    return v;
}

void HNWR::executeEvent() {

    el_set.AllElectrons = GetAllElectronViews();
    mu_set.AllMuons = GetAllMuonViews();
    jet_set.AllJets = GetAllJetViews();
    fatjet_set.AllFatJets = GetAllFatJets();
    // Gen / LHE branches do not exist in data. v13's GetAllGens()/GetAllLHEs()
    // returned empty vectors there; a v15 view would try to bind branches that
    // are not in the file, so the collections are left default-constructed
    // (size() == 0), which every consumer below already handles.
    if (!IsDATA) {
        gen_set.gens = GetAllGenViews();
        lhe_set.lhe_parts = GetAllLHEViews();
    } else {
        gen_set.gens = GenViewCollection();
        lhe_set.lhe_parts = LHEViewCollection();
    }

    SetSignalFlags();

    for (const auto &syst_dummy : *systHelper) {
        static_cast<void>(syst_dummy);
        executeEventFromParameter();
    }

}

void HNWR::executeEventFromParameter() {
    // v13 held this as a TString and used Contains(); FillHist now takes a
    // std::string_view, so the directory prefixes are built as std::string.
    const std::string this_syst = systHelper->getCurrentSysName();

    // RunXsecSyst produces one thing only: the per-PDF-member fit observable, which is
    // filled in the Central pass. Every object-variation pass (JES/JER/... , evtLoopAgain:
    // true) would re-run the whole event to fill histograms this job does not write, so
    // leave immediately. Cuts the job to a single pass over the events.
    if (RunXsecSyst && this_syst != "Central") return;
    if (FOMode && this_syst != "Central") return;

    Event ev = GetEvent();
    Particle METv = ev.GetMETVector(Event::MET_Type::PUPPI, SKNano::Variation::nom,
                                    Event::MET_Syst::CENTRAL);

    std::unordered_map<std::string, std::variant<std::function<float(MyCorrection::variation, TString)>, std::function<float()>>> weight_function_map;
    weight_function_map.reserve(30);  // Pre-allocate to avoid rehashing
    static auto dummy_sf = [](MyCorrection::variation var, TString source) -> float {
        static_cast<void>(var); static_cast<void>(source); return 1.0f; };

    weight_function_map["PU_Weight"]     = dummy_sf;
    // Electron Targets
    weight_function_map["E_Id_Weight"]   = dummy_sf;
    weight_function_map["E_Reco_Weight"] = dummy_sf;
    weight_function_map["E_Trig_Weight"] = dummy_sf;

    // Muon Targets
    weight_function_map["M_Id_Weight"]   = dummy_sf;
    weight_function_map["M_Reco_Weight"] = dummy_sf;
    weight_function_map["M_Trig_Weight"] = dummy_sf;

    // Jet Targets (object variations, not weight variations)
    weight_function_map["JER_Variation"] = dummy_sf;
    weight_function_map["JES_Variation"] = dummy_sf;
    // Object-level kinematic variations: the systematic is applied by re-running the event
    // with a varied collection, so the weight target is a dummy (see data/config/MCLRSM.yaml).
    weight_function_map["MuonScale_Variation"]     = dummy_sf;
    weight_function_map["MuonRes_Variation"]       = dummy_sf;
    weight_function_map["ElectronScale_Variation"] = dummy_sf;
    weight_function_map["ElectronRes_Variation"]   = dummy_sf;
    weight_function_map["M_Iso_Weight"]  = dummy_sf;
    // LSF3 cut efficiency SF: assigned only in the boosted SR / flavor CR branches
    weight_function_map["LSF_Weight"]    = dummy_sf;

    // XSec(theory) weight targets
    weight_function_map["ScaleWeight_muF"] = dummy_sf;
    weight_function_map["ScaleWeight_muR"] = dummy_sf;
    weight_function_map["PDF_Weight"]      = dummy_sf;
    weight_function_map["AlphaS_Weight"]   = dummy_sf;

    // DY gen Z-pT correction targets: assigned below for DY MC, left at 1 for
    // everything else.
    weight_function_map["ZPt_Weight"]       = dummy_sf;
    weight_function_map["ZPt_QCDScale"]     = dummy_sf;
    weight_function_map["ZPt_QCDPDFError"]  = dummy_sf;
    weight_function_map["ZPt_QCDPDFAlphaS"] = dummy_sf;
    weight_function_map["ZPt_EW1"]          = dummy_sf;
    weight_function_map["ZPt_EW2"]          = dummy_sf;
    weight_function_map["ZPt_EW3"]          = dummy_sf;

    weight_function_map["PU_Weight"] = [&](MyCorrection::variation var, TString source) {
        static_cast<void>(source);
        return myCorr->GetPUWeight(ev.nTrueInt(), var);
    };

    // --- C(gen Z pT), DY MC only.
    //
    // Four targets, but only ZPt_Weight returns C at nominal; the other three
    // return 1 there and the ratio C_var/C_nom for their variation. That is
    // deliberate: calculateWeight() multiplies the nominal of *every* target
    // into the central weight, so having all four return C would apply it four
    // times over. This way Central carries exactly one factor of C, and each
    // variation swaps in its own curve.
    //
    // The four are also disjoint in what they vary: ZPt_Weight is the MC
    // statistical error of C, the other three are the theory variations of its
    // NLO numerator. Nothing here uses ZPTReweight_Up/Down -- that pair is the
    // quadrature sum of the same three theory groups, so it overlaps them
    // completely and is kept in the file for plotting only.
    // C_nom * EW_nom of this event, for DYCRStudy to divide the corrections back
    // out of the Central weight. 1 when no correction applies.
    dycr_cew_nom = 1.f;
    dycr_ew_nom = 1.f;
    if (dycorr.apply) {
        const float gen_zpt = GetGenZpT();
        if (dycorr.by_njet)
            dy_n_genjet = HNWRDY::CountGenJets(gen_set.gens, GetAllGenJetViews());
        if (gen_zpt < 0.) {
            // No GenPart Z and no status-1 OSSF e/mu pair (HNWRDY::FindGenZ):
            // leave the event uncorrected (every DY target returns 1 for a
            // negative gen_zpt) and say so once. This is rare and expected --
            // e.g. Z->tautau events without a status-62 Z -- and not the
            // hard failure the old isHardProcess definition treated it as.
            static bool warned = false;
            if (!warned) {
                std::cout << "[HNWR] WARNING: no gen Z found for a DY event (run "
                          << static_cast<unsigned int>(RunNumber) << ", event "
                          << static_cast<unsigned long long>(event) << ", sample " << MCSample
                          << "); C/EW = 1 for such events. Reported once." << std::endl;
                warned = true;
            }
        }
        const float c_nom = GetZptWeight(gen_zpt, "ZPTReweight");
        // ZPt_Weight carries C at nominal and its MC STATISTICAL error as the
        // variation (nuisance ZPtRw_MC_stat). It deliberately does NOT use
        // ZPTReweight_Up/Down: those are QCDScale (+) QCDPDFError (+)
        // QCDPDFAlphaS added in quadrature, i.e. exactly the three theory
        // targets below, so using them here would count the theory band twice
        // and leave the statistical error of C out of the fit entirely.
        const float c_stat = GetZptStat(gen_zpt);
        weight_function_map["ZPt_Weight"] = [&, gen_zpt, c_nom, c_stat](MyCorrection::variation var, TString source) -> float {
            static_cast<void>(gen_zpt); static_cast<void>(source);
            if (var == MyCorrection::variation::up)
                return c_nom + c_stat;
            if (var == MyCorrection::variation::down)
                // sigma_stat stays well below C over the delivered range (worst
                // bin ~17% of C), but never let the weight reach 0: that would
                // delete the event rather than down-weight it.
                return std::max(c_nom - c_stat, 1e-3f);
            return c_nom;
        };
        auto zpt_ratio_target = [&, gen_zpt, c_nom](const char *up_key, const char *dn_key) {
            return [this, gen_zpt, c_nom, up_key, dn_key](MyCorrection::variation var, TString source) -> float {
                static_cast<void>(source);
                if (c_nom <= 0.) return 1.f;
                if (var == MyCorrection::variation::up)
                    return GetZptWeight(gen_zpt, up_key) / c_nom;
                if (var == MyCorrection::variation::down)
                    return GetZptWeight(gen_zpt, dn_key) / c_nom;
                return 1.f;
            };
        };
        weight_function_map["ZPt_QCDScale"] =
            zpt_ratio_target("ZPTReweight_QCDScaleUp", "ZPTReweight_QCDScaleDown");
        weight_function_map["ZPt_QCDPDFError"] =
            zpt_ratio_target("ZPTReweight_QCDPDFErrorUp", "ZPTReweight_QCDPDFErrorDown");
        weight_function_map["ZPt_QCDPDFAlphaS"] =
            zpt_ratio_target("ZPTReweight_QCDPDFAlphaSUp", "ZPTReweight_QCDPDFAlphaSDown");

        // --- EW(gen Z pT), same one-factor-of-EW bookkeeping as C above:
        // ZPt_EW1 carries the EW nominal and its e1 variation; EW2/EW3 return
        // 1 at nominal and the ratio EW_var/EW_nom, so Central picks up the
        // EW correction exactly once and each of the three uncertainty
        // sources of arXiv:1705.04664 varies independently.
        const float ew_nom = GetZptEW(gen_zpt);
        dycr_cew_nom = c_nom * ew_nom;
        dycr_ew_nom = ew_nom;
        weight_function_map["ZPt_EW1"] = [this, gen_zpt, ew_nom](MyCorrection::variation var, TString source) -> float {
            static_cast<void>(source);
            if (var == MyCorrection::variation::up)
                return GetZptEW(gen_zpt, 1, +1);
            if (var == MyCorrection::variation::down)
                return GetZptEW(gen_zpt, 1, -1);
            return ew_nom;
        };
        auto ew_ratio_target = [this, gen_zpt, ew_nom](int which) {
            return [this, gen_zpt, ew_nom, which](MyCorrection::variation var, TString source) -> float {
                static_cast<void>(source);
                if (ew_nom <= 0.) return 1.f;
                if (var == MyCorrection::variation::up)
                    return GetZptEW(gen_zpt, which, +1) / ew_nom;
                if (var == MyCorrection::variation::down)
                    return GetZptEW(gen_zpt, which, -1) / ew_nom;
                return 1.f;
            };
        };
        weight_function_map["ZPt_EW2"] = ew_ratio_target(2);
        weight_function_map["ZPt_EW3"] = ew_ratio_target(3);
    }

    // --- XSec(theory) weight systematics ---
    // Each function returns the absolute event weight for the given variation (nom == 1),
    // so calculateWeight() forms Up/Down by nominal_weight / nom * up(down).
    //
    // ACCEPTANCE ONLY: every LHE weight below is divided by the inclusive normalisation
    // K_var of its own index (theoryK_scale / theoryK_pdf; see LoadTheoryNormK). The raw
    // weights are inclusive-xsec change TIMES acceptance change, and these four nuisances
    // are signal-only in the datacards, so they must carry acceptance alone. Without the
    // division the nuisance is dominated by the normalisation -- WR4000 is ~35% inclusive
    // PDF against a few-% acceptance -- which inflates it by roughly an order of magnitude
    // and makes the limit correspondingly conservative. The inclusive piece is instead
    // drawn as the theory band of the exclusion plot (the Run2 "SignalScale lnN" slot).
    // K = 1 for any sample without a table entry, reproducing the previous behaviour.
    // muF: vary factorization scale, keep renormalization scale nominal.
    weight_function_map["ScaleWeight_muF"] = [&](MyCorrection::variation var, TString source) -> float {
        static_cast<void>(source);
        if (!nLHEScaleWeight.valid()) return 1.f;  // pythia-only sample: no LHE weights
        const float r = GetScaleVariation(var, MyCorrection::variation::nom);
        return r / GetTheoryNormK(theoryK_scale,
                                  GetScaleVariationIndex(var, MyCorrection::variation::nom));
    };
    // muR: vary renormalization scale, keep factorization scale nominal.
    // NOTE: for the WR signal this is identically 1 both before and after normalisation --
    // W_R production is EW at LO, so the matrix element has no alpha_S and no muR
    // dependence (the 9 weights are 3 identical blocks). The nuisance is only meaningful
    // for backgrounds, which the datacards do not attach it to; see the theory_norm_split
    // README section 6 for the card-side decision this still needs.
    weight_function_map["ScaleWeight_muR"] = [&](MyCorrection::variation var, TString source) -> float {
        static_cast<void>(source);
        if (!nLHEScaleWeight.valid()) return 1.f;  // pythia-only sample: no LHE weights
        const float r = GetScaleVariation(MyCorrection::variation::nom, var);
        return r / GetTheoryNormK(theoryK_scale,
                                  GetScaleVariationIndex(MyCorrection::variation::nom, var));
    };
    // PDF envelope: RETIRED as a weight target -- it stays at the dummy 1.
    //
    // A Hessian envelope is a quadrature sum over members OF THE OBSERVABLE,
    // dN(bin) = sqrt(sum_i (N_i(bin) - N_0(bin))^2), and N_i(bin) is itself a sum over
    // events. A single event weight cannot express that: (sum_evt x)^2 != sum_evt x^2.
    // The old implementation took the envelope event by event, which adds |shift| with no
    // cancellation even though every member pushes all events the same way. Measured on
    // WR4000N2100EE / 2022EE: 71.4% in SR_Resolved_EE and 73.6% in SR_Boosted_EE, against
    // 0.45% and 1.92% for the correct envelope -- a factor 157 and 38. Before any
    // selection, where closure demands 0, it gave 0.73 instead of 0.0034.
    //
    // The replacement is the RunXsecSyst userflag: it writes PDFmem<i>/<region>_mlljj, one
    // histogram per member, and the envelope is formed after hadd by
    // tables/06_systematics/theory_norm_split/make_pdf_envelope.py. Per-member histograms
    // have to survive hadd -- they add linearly, an envelope does not -- which is why the
    // members are stored rather than accumulated into a single number in the job.
    //
    // The "PDF" entry is removed from data/config/MCLRSM*.yaml, so this target is now unreferenced;
    // it is kept defined so an older yaml still resolves instead of crashing.
    // alpha_S: dedicated PDF members (101 = down, 102 = up).
    weight_function_map["AlphaS_Weight"] = [&](MyCorrection::variation var, TString source) -> float {
        static_cast<void>(source);
        if (!nLHEPdfWeight.valid() || nLHEPdfWeight < 103) return 1.f;
        if (var == MyCorrection::variation::up)   return LHEPdfWeight[102] / GetTheoryNormK(theoryK_pdf, 102);
        if (var == MyCorrection::variation::down) return LHEPdfWeight[101] / GetTheoryNormK(theoryK_pdf, 101);
        return 1.f;
    };

    //Event Bool Categorization

    // Resolved
    ///DY CR
    bool is_Resolved_DY_EE(false);
    bool is_Resolved_DY_MM(false);

    // DY CR split in mll: CR1 = 60-100, CR2 = 100-150 (subsets of the 60-150 DY CR)
    bool is_Resolved_DY_EE_CR1(false);
    bool is_Resolved_DY_EE_CR2(false);
    bool is_Resolved_DY_MM_CR1(false);
    bool is_Resolved_DY_MM_CR2(false);

    bool is_Resolved_DY_EE_SS(false);
    bool is_Resolved_DY_EE_SS_2e_tight(false);
    bool is_Resolved_DY_EE_SS_1e_tight(false);
    bool is_Resolved_DY_EE_SS_0e_tight(false);

    bool is_Resolved_DY_EE_OS(false);
    bool is_Resolved_DY_EE_OS_2e_tight(false);
    bool is_Resolved_DY_EE_OS_1e_tight(false);
    bool is_Resolved_DY_EE_OS_0e_tight(false);

    bool is_Resolved_DY_MM_SS(false);
    bool is_Resolved_DY_MM_SS_tight(false);
    bool is_Resolved_DY_MM_SS_not_tight(false);

    bool is_Resolved_DY_MM_OS(false);
    bool is_Resolved_DY_MM_OS_tight(false);
    bool is_Resolved_DY_MM_OS_not_tight(false);

    ///FLAV CR
    bool is_Resolved_Flav_EM(false);

    bool is_Resolved_Flav_EM_SS(false);
    bool is_Resolved_Flav_EM_SS_tight(false);
    bool is_Resolved_Flav_EM_SS_not_tight(false);

    bool is_Resolved_Flav_EM_SS_M_tight_E_tight(false);
    bool is_Resolved_Flav_EM_SS_M_tight_E_not_tight(false);
    bool is_Resolved_Flav_EM_SS_M_not_tight_E_tight(false);
    bool is_Resolved_Flav_EM_SS_M_not_tight_E_not_tight(false);

    bool is_Resolved_Flav_EM_OS(false);
    bool is_Resolved_Flav_EM_OS_tight(false);
    bool is_Resolved_Flav_EM_OS_not_tight(false);

    bool is_Resolved_Flav_EM_OS_M_tight_E_tight(false);
    bool is_Resolved_Flav_EM_OS_M_tight_E_not_tight(false);
    bool is_Resolved_Flav_EM_OS_M_not_tight_E_tight(false);
    bool is_Resolved_Flav_EM_OS_M_not_tight_E_not_tight(false);

    /// SR
    bool is_Resolved_SR_EE(false);

    bool is_Resolved_SR_EE_SS(false);
    bool is_Resolved_SR_EE_SS_2e_tight(false);
    bool is_Resolved_SR_EE_SS_1e_tight(false);
    bool is_Resolved_SR_EE_SS_0e_tight(false);

    bool is_Resolved_SR_EE_OS(false);
    bool is_Resolved_SR_EE_OS_2e_tight(false);
    bool is_Resolved_SR_EE_OS_1e_tight(false);
    bool is_Resolved_SR_EE_OS_0e_tight(false);

    bool is_Resolved_SR_MM(false);
    bool is_Resolved_SR_MM_SS(false);
    bool is_Resolved_SR_MM_SS_tight(false);
    bool is_Resolved_SR_MM_SS_not_tight(false);

    bool is_Resolved_SR_MM_OS(false);
    bool is_Resolved_SR_MM_OS_tight(false);
    bool is_Resolved_SR_MM_OS_not_tight(false);

    // Boosted
    /// DY CR
    bool is_Boosted_DY_EE(false);
    bool is_Boosted_DY_MM(false);

    // DY CR split in mll: CR1 = 60-100, CR2 = 100-150 (subsets of the 60-150 DY CR)
    bool is_Boosted_DY_EE_CR1(false);
    bool is_Boosted_DY_EE_CR2(false);
    bool is_Boosted_DY_MM_CR1(false);
    bool is_Boosted_DY_MM_CR2(false);

    bool is_Boosted_DY_EE_SS(false);
    bool is_Boosted_DY_EE_SS_2e_tight(false);
    bool is_Boosted_DY_EE_SS_1e_tight(false);
    bool is_Boosted_DY_EE_SS_0e_tight(false);

    bool is_Boosted_DY_EE_OS(false);
    bool is_Boosted_DY_EE_OS_2e_tight(false);
    bool is_Boosted_DY_EE_OS_1e_tight(false);
    bool is_Boosted_DY_EE_OS_0e_tight(false);

    bool is_Boosted_DY_MM_SS(false);
    bool is_Boosted_DY_MM_SS_tight(false);
    bool is_Boosted_DY_MM_SS_not_tight(false);

    bool is_Boosted_DY_MM_OS(false);
    bool is_Boosted_DY_MM_OS_tight(false);
    bool is_Boosted_DY_MM_OS_not_tight(false);

    /// FLAV CR
    bool is_Boosted_Flav_EMJ(false);
    bool is_Boosted_Flav_MEJ(false);

    bool is_Boosted_Flav_EMJ_SS(false);

    bool is_Boosted_Flav_EMJ_SS_tight(false);
    bool is_Boosted_Flav_EMJ_SS_not_tight(false);
    bool is_Boosted_Flav_EMJ_SS_M_tight_E_tight(false);
    bool is_Boosted_Flav_EMJ_SS_M_tight_E_not_tight(false);
    bool is_Boosted_Flav_EMJ_SS_M_not_tight_E_tight(false);
    bool is_Boosted_Flav_EMJ_SS_M_not_tight_E_not_tight(false);

    bool is_Boosted_Flav_EMJ_OS(false);
    bool is_Boosted_Flav_EMJ_OS_tight(false);
    bool is_Boosted_Flav_EMJ_OS_not_tight(false);
    bool is_Boosted_Flav_EMJ_OS_M_tight_E_tight(false);
    bool is_Boosted_Flav_EMJ_OS_M_tight_E_not_tight(false);
    bool is_Boosted_Flav_EMJ_OS_M_not_tight_E_tight(false);
    bool is_Boosted_Flav_EMJ_OS_M_not_tight_E_not_tight(false);

    bool is_Boosted_Flav_MEJ_SS(false);

    bool is_Boosted_Flav_MEJ_SS_tight(false);
    bool is_Boosted_Flav_MEJ_SS_not_tight(false);
    bool is_Boosted_Flav_MEJ_SS_M_tight_E_tight(false);
    bool is_Boosted_Flav_MEJ_SS_M_tight_E_not_tight(false);
    bool is_Boosted_Flav_MEJ_SS_M_not_tight_E_tight(false);
    bool is_Boosted_Flav_MEJ_SS_M_not_tight_E_not_tight(false);

    bool is_Boosted_Flav_MEJ_OS(false);

    bool is_Boosted_Flav_MEJ_OS_tight(false);
    bool is_Boosted_Flav_MEJ_OS_not_tight(false);
    bool is_Boosted_Flav_MEJ_OS_M_tight_E_tight(false);
    bool is_Boosted_Flav_MEJ_OS_M_tight_E_not_tight(false);
    bool is_Boosted_Flav_MEJ_OS_M_not_tight_E_tight(false);
    bool is_Boosted_Flav_MEJ_OS_M_not_tight_E_not_tight(false);

    /// SR
    bool is_Boosted_SR_EE(false);

    bool is_Boosted_SR_EE_SS(false);
    bool is_Boosted_SR_EE_SS_2e_tight(false);
    bool is_Boosted_SR_EE_SS_1e_tight(false);
    bool is_Boosted_SR_EE_SS_0e_tight(false);

    bool is_Boosted_SR_EE_OS(false);

    bool is_Boosted_SR_EE_OS_2e_tight(false);
    bool is_Boosted_SR_EE_OS_1e_tight(false);
    bool is_Boosted_SR_EE_OS_0e_tight(false);

    bool is_Boosted_SR_MM(false);

    bool is_Boosted_SR_MM_SS(false);
    bool is_Boosted_SR_MM_SS_tight(false);
    bool is_Boosted_SR_MM_SS_not_tight(false);

    bool is_Boosted_SR_MM_OS(false);
    bool is_Boosted_SR_MM_OS_tight(false);
    bool is_Boosted_SR_MM_OS_not_tight(false);

    //Event values

    //Resolved
    float Resolve_DYCREEpt = 0.;
    // Low-jet-multiplicity dilepton region (userflag DYCRSplit): two tight same-flavour leptons,
    // trigger, fewer than two selected AK4 jets and NO selected AK8 jet. With < 2 AK4 jets the
    // event cannot be resolved, and without an AK8 jet it cannot be boosted, so the region is
    // disjoint from every signal region at any m(ll) -- which is what lets m(ll) be shown to 2 TeV.
    int LowJet_flav = 0;          // 0 none, 1 EE, 2 MM
    int LowJet_njet = -1;         // 0 or 1
    float LowJet_mll = 0., LowJet_ptll = 0.;
    float Resolve_DYCREEmass = 0.;
    float Resolve_DYCREEeta = 0.;
    float Resolve_DYCREEphi = 0.;
    float Resolve_DYCREEleadjetpt = 0.;
    float Resolve_DYCREEleadjeteta = 0.;
    float Resolve_DYCREEleadjetphi = 0.;
    float Resolve_DYCREEsubleadjetpt = 0.;
    float Resolve_DYCREEsubleadjeteta = 0.;
    float Resolve_DYCREEsubleadjetphi = 0.;
    float Resolve_DYCREEj1j2mass = 0.;
    float Resolve_DYCREEj1j2pt = 0.;
    float Resolve_DYCREEj1j2eta = 0.;
    float Resolve_DYCREEj1j2phi = 0.;
    float Resolve_DYCREEl1j1j2mass = 0.;
    float Resolve_DYCREEl1j1j2pt = 0.;
    float Resolve_DYCREEl1j1j2eta = 0.;
    float Resolve_DYCREEl1j1j2phi = 0.;
    float Resolve_DYCREEl2j1j2mass = 0.;
    float Resolve_DYCREEl2j1j2pt = 0.;
    float Resolve_DYCREEl2j1j2eta = 0.;
    float Resolve_DYCREEl2j1j2phi = 0.;
    float Resolve_DYCREEmlljj = 0.;
    float Resolve_DYCREEmlljjpt = 0.;
    float Resolve_DYCREEmlljjeta = 0.;
    float Resolve_DYCREEmlljjphi = 0.;
    float Resolve_DYCREEleadleppt = 0.;
    float Resolve_DYCREEleadlepeta = 0.;
    float Resolve_DYCREEleadlepphi = 0.;
    float Resolve_DYCREEsubleadleppt = 0.;
    float Resolve_DYCREEsubleadlepeta = 0.;
    float Resolve_DYCREEsubleadlepphi = 0.;
    float Resolve_DYCREEjetnum = 0.;
    float Resolve_DYCREEpunum = 0.;
    float Resolve_DYCREEpvgood = 0.;
    float Resolve_DYCREEpv = 0.;

    float Resolve_DYCRMMpt = 0.;
    float Resolve_DYCRMMmass = 0.;
    float Resolve_DYCRMMeta = 0.;
    float Resolve_DYCRMMphi = 0.;
    float Resolve_DYCRMMleadjetpt = 0.;
    float Resolve_DYCRMMleadjeteta = 0.;
    float Resolve_DYCRMMleadjetphi = 0.;
    float Resolve_DYCRMMsubleadjetpt = 0.;
    float Resolve_DYCRMMsubleadjeteta = 0.;
    float Resolve_DYCRMMsubleadjetphi = 0.;
    float Resolve_DYCRMMj1j2mass = 0.;
    float Resolve_DYCRMMj1j2pt = 0.;
    float Resolve_DYCRMMj1j2eta = 0.;
    float Resolve_DYCRMMj1j2phi = 0.;
    float Resolve_DYCRMMl1j1j2mass = 0.;
    float Resolve_DYCRMMl1j1j2pt = 0.;
    float Resolve_DYCRMMl1j1j2eta = 0.;
    float Resolve_DYCRMMl1j1j2phi = 0.;
    float Resolve_DYCRMMl2j1j2mass = 0.;
    float Resolve_DYCRMMl2j1j2pt = 0.;
    float Resolve_DYCRMMl2j1j2eta = 0.;
    float Resolve_DYCRMMl2j1j2phi = 0.;
    float Resolve_DYCRMMmlljj = 0.;
    float Resolve_DYCRMMmlljjpt = 0.;
    float Resolve_DYCRMMmlljjeta = 0.;
    float Resolve_DYCRMMmlljjphi = 0.;
